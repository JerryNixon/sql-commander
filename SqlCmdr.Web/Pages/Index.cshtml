            async init() {
                await this.loadSettings();
                this.initEditor();
                this.bindUiActions();
                this.setupStatusTitles();
                await this.loadMetadata({ maxAttempts: this.maxMetadataAttempts });
                await this.refreshDataApiStatus();
                this.startDataApiStatusPolling();
                this.setupKeyboardShortcuts();
                this.setupResizers();
                this.renderNavigationRoutes();
                window.addEventListener('popstate', () => this.applyCurrentRoute());
                await this.applyCurrentRoute({ replace: true });
            },

            bindUiActions() {
                const refreshBtn = document.getElementById('refreshMetadataBtn');
                if (refreshBtn && !refreshBtn.dataset.bound) {
                    refreshBtn.addEventListener('click', () => this.refreshMetadata());
                    refreshBtn.dataset.bound = 'true';
                }

                const viewSchemaBtn = document.getElementById('viewSchemaBtn');
                if (viewSchemaBtn && !viewSchemaBtn.dataset.bound) {
                    viewSchemaBtn.addEventListener('click', () => this.navigateTo('/app/diagram'));
                    viewSchemaBtn.dataset.bound = 'true';
                }

                const dabBtn = document.getElementById('dataApiBuilderBtn');
                if (dabBtn && !dabBtn.dataset.bound) {
                    dabBtn.addEventListener('click', () => this.navigateTo('/app/data-api/objects'));
                    dabBtn.dataset.bound = 'true';
                }

                const settingsModal = document.getElementById('settingsModal');
                if (settingsModal && !settingsModal.dataset.bound) {
                    settingsModal.addEventListener('input', (event) => {
                        if (event.target.closest('.settings-panel')) {
                            this.refreshConnectionStringPreview();
                        }
                    });
                    settingsModal.addEventListener('change', (event) => {
                        if (event.target.closest('.settings-panel')) {
                            this.refreshConnectionStringPreview();
                        }
                    });
                    settingsModal.dataset.bound = 'true';
                }

                const treeContainer = document.getElementById('treeContainer');
                if (treeContainer && !treeContainer.dataset.bound) {
                    treeContainer.addEventListener('keydown', (event) => this.handleTreeKeyDown(event));
                    treeContainer.dataset.bound = 'true';
                }

                if (!document.body.dataset.objectMenuBound) {
                    document.addEventListener('click', () => this.closeObjectMenus());
                    document.addEventListener('click', (event) => {
                        if (!event.target.closest('#dataApiStatusMenu') && !event.target.closest('#statusDataApiSegment')) {
                            this.hideDataApiMenu();
                        }
                    });
                    document.addEventListener('click', (event) => this.handleFloatingExplorerOutsideClick(event));
                    document.body.dataset.objectMenuBound = 'true';
                }
            },

            delay(ms) {
                return new Promise(resolve => setTimeout(resolve, ms));
            },

            t(key) {
                return this.translations[this.language]?.[key] || this.translations.en[key] || key;
            },

            applyLocalization() {
                this.language = this.settings?.language || this.language || 'en';
                document.documentElement.lang = this.language;

                document.querySelectorAll('[data-i18n]').forEach(element => {
                    element.textContent = this.t(element.dataset.i18n);
                });

                document.querySelectorAll('[data-i18n-placeholder]').forEach(element => {
                    element.placeholder = this.t(element.dataset.i18nPlaceholder);
                });

                document.querySelectorAll('[data-i18n-title]').forEach(element => {
                    element.title = this.t(element.dataset.i18nTitle);
                });

                document.querySelectorAll('[data-i18n-aria-label]').forEach(element => {
                    element.setAttribute('aria-label', this.t(element.dataset.i18nAriaLabel));
                });

                this.updateLocalizedDynamicText();
                this.renderNavigationRoutes();
                this.setupStatusTitles();
            },

            getAppRoutePath(pathname = window.location.pathname) {
                const path = pathname.replace(/\/+$/, '') || '/';
                const lower = path.toLowerCase();
                const appIndex = lower.indexOf('/app');
                return appIndex >= 0 ? (path.slice(appIndex) || '/app/query') : '/app/query';
            },

            getAppPathPrefix(pathname = window.location.pathname) {
                const lower = pathname.toLowerCase();
                const appIndex = lower.indexOf('/app');
                return appIndex >= 0 ? pathname.slice(0, appIndex) : '';
            },

            buildAppUrl(routePath) {
                const prefix = this.getAppPathPrefix();
                const normalized = routePath.startsWith('/app') ? routePath : `/app/${routePath.replace(/^\/+/, '')}`;
                return `${prefix}${normalized}`;
            },

            async navigateTo(routePath, { replace = false } = {}) {
                const url = this.buildAppUrl(routePath);
                const target = `${url}${window.location.hash}`;
                if (replace) {
                    history.replaceState({}, '', target);
                } else if (`${window.location.pathname}${window.location.hash}` !== target) {
                    history.pushState({}, '', target);
                }
                await this.applyCurrentRoute({ replace: true });
            },

            replaceRoute(routePath) {
                history.replaceState({}, '', this.buildAppUrl(routePath));
                this.currentAppRoute = this.normalizeAppRoute(routePath);
            },

            async applyCurrentRoute({ replace = false } = {}) {
                const routePath = this.normalizeAppRoute(this.getAppRoutePath());
                if (replace && this.getAppRoutePath() !== routePath) {
                    history.replaceState({}, '', this.buildAppUrl(routePath));
                }
                await this.applyRoute(routePath);
            },

            normalizeAppRoute(routePath) {
                const normalized = (routePath || '/app/query').replace(/\/+$/, '') || '/app/query';
                const aliases = {
                    '/': '/app/query',
                    '/app': '/app/query',
                    '/app/settings': '/app/settings/app',
                    '/app/settings/connection-properties': '/app/settings/connection',
                    '/app/data-api/settings': '/app/data-api/objects',
                    '/app/dab': '/app/data-api/objects',
                    '/app/dab/objects': '/app/data-api/objects',
                    '/app/dab/settings': '/app/data-api/objects',
                    '/app/dab/running': '/app/data-api/running'
                };
                return aliases[normalized.toLowerCase()] || normalized;
            },

            closeRoutedSurfaces() {
                this.hideSettings(false);
                this.hideSchema(false);
                this.hideDabDialog(false);
                this.hideDataApiMenu();
            },

            async applyRoute(routePath) {
                if (this.applyingRoute) return;
                this.applyingRoute = true;
                this.currentAppRoute = routePath;
                try {
                    if (routePath.startsWith('/app/settings')) {
                        this.hideSchema(false);
                        this.hideDabDialog(false);
                        const tab = this.getSettingsTabFromRoute(routePath);
                        await this.showSettings(tab);
                        if (routePath === '/app/settings/connection-string') {
                            await this.applyConnectionStringFromRoute();
                        }
                        return;
                    }

                    if (routePath === '/app/diagram') {
                        this.hideSettings(false);
                        this.hideDabDialog(false);
                        await this.showSchema();
                        return;
                    }

                    if (routePath.startsWith('/app/data-api')) {
                        this.hideSettings(false);
                        this.hideSchema(false);
                        await this.showDabDialog();
                        if (routePath === '/app/data-api/objects' && !document.getElementById('dabSelectPanel')?.hidden) {
                            this.showDabTab('objects');
                        } else if (routePath === '/app/data-api/running') {
                            const status = await this.refreshDataApiStatus({ preserveRunning: this.dataApiStatus?.running === true });
                            this.showDabRuntimePanel(status);
                        }
                        return;
                    }

                    this.closeRoutedSurfaces();
                } finally {
                    this.applyingRoute = false;
                }
            },

            getSettingsTabFromRoute(routePath) {
                if (routePath.endsWith('/connection')) return 'properties';
                if (routePath.endsWith('/connection-string')) return 'connectionString';
                if (routePath.endsWith('/data-api')) return 'dataApi';
                if (routePath.endsWith('/navigation')) return 'navigation';
                return 'app';
            },

            async applyConnectionStringFromRoute() {
                const params = new URLSearchParams(window.location.search);
                const connectionString = this.getRouteConnectionString(params);
                if (!connectionString || connectionString === this.lastRouteConnectionString) return;

                this.lastRouteConnectionString = connectionString;
                const input = document.getElementById('settingConnectionStringInput');
                if (input) input.value = connectionString;

                try {
                    const parseResponse = await fetch('?handler=ParseConnectionString', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ connectionString })
                    });
                    const parseResult = await parseResponse.json();
                    if (!parseResponse.ok || !parseResult.success) {
                        throw new Error(parseResult.errorMessage || parseResponse.statusText || 'Could not parse connection string.');
                    }

                    const settings = { ...this.collectSettingsFromForm(), ...parseResult.settings };
                    const saveResponse = await fetch('?handler=Settings', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(settings)
                    });
                    const saveResult = await saveResponse.json();
                    if (!saveResponse.ok || !saveResult.success) {
                        throw new Error(saveResult.errorMessage || saveResponse.statusText || 'Could not save connection settings.');
                    }

                    this.settings = saveResult.settings;
                    this.populateSettingsForm(this.settings);
                    this.applyTheme();
                    this.applyLocalization();
                    this.updateStatusFromSettings();

                    // Connection strings often include passwords; remove ?constr=... from the visible URL immediately.
                    history.replaceState({}, '', this.buildAppUrl('/app/query'));
                    this.closeRoutedSurfaces();
                    await this.loadMetadata({ maxAttempts: this.maxMetadataAttempts });
                } catch (error) {
                    console.error('Connection string route error:', error);
                    history.replaceState({}, '', this.buildAppUrl('/app/settings/connection-string'));
                    alert(`Could not set the connection string from the URL:\n\n${error.message || error}`);
                }
            },

            getRouteConnectionString(params) {
                const encoded = params.get('constr64');
                if (encoded) {
                    return this.decodeBase64Url(encoded);
                }

                return params.get('constr') || '';
            },

            decodeBase64Url(value) {
                const normalized = String(value || '')
                    .replace(/-/g, '+')
                    .replace(/_/g, '/');
                const padded = normalized.padEnd(normalized.length + ((4 - normalized.length % 4) % 4), '=');
                const binary = atob(padded);
                const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
                return new TextDecoder().decode(bytes);
            },

            renderNavigationRoutes() {
                const container = document.getElementById('navigationRouteList');
                if (!container) return;
                container.innerHTML = this.appRoutes.map(route => {
                    const url = this.buildAppUrl(route.path);
                    return `<div class="navigation-route-card">
                        <div class="navigation-route-main">
                            <div class="navigation-route-title">${this.escapeHtml(this.t(route.labelKey))}</div>
                            <a class="navigation-route-path" href="${this.escapeHtml(url)}" onclick="event.preventDefault(); app.navigateTo('${this.escapeHtml(route.path)}')">${this.escapeHtml(url)}</a>
                            <div class="navigation-route-description">${this.escapeHtml(this.t(route.descriptionKey))}</div>
                        </div>
                    </div>`;
                }).join('');
            },

            updateLocalizedDynamicText() {
                const query = document.getElementById('statusQuery');
                if (query && (!query.dataset.state || query.dataset.state === 'idle')) {
                    query.dataset.state = 'idle';
                    query.textContent = this.t('idle');
                }

                const empty = document.querySelector('#resultsContainer .empty-state');
                if (empty) {
                    empty.textContent = this.t('noResults');
                }

                if (this.editor) {
                    const placeholders = Object.values(this.translations)
                        .map(translation => translation.editorPlaceholder)
                        .filter(Boolean);
                    if (placeholders.includes(this.editor.getValue())) {
                        this.editor.setValue(this.t('editorPlaceholder'));
                    }
                }
            },

            applyTheme() {
                const theme = this.settings?.theme || 'dark';
                document.body.classList.toggle('light-theme', theme === 'light');
                if (this.editor && typeof monaco !== 'undefined') {
                    monaco.editor.setTheme(theme === 'light' ? 'vs' : 'vs-dark');
                }
            },

            previewLanguage(language) {
                this.language = language || 'en';
                this.settings = { ...(this.settings || {}), language: this.language };
                this.applyLocalization();
                this.refreshConnectionStringPreview();
            },

            setStatusQuery(state, text) {
                const element = document.getElementById('statusQuery');
                if (!element) return;
                element.dataset.state = state || '';
                element.textContent = text || this.t(state) || text || '';
            },

            setupStatusTitles() {
                const bindings = [
                    { valueId: 'statusServer', segmentId: 'statusServerSegment', labelKey: 'statusServerTitle' },
                    { valueId: 'statusUser', segmentId: 'statusUserSegment', labelKey: 'statusUserTitle' },
                    { valueId: 'statusDatabase', segmentId: 'statusDatabaseSegment', labelKey: 'statusDatabaseTitle' },
                    { valueId: 'statusQuery', segmentId: 'statusQuerySegment', labelKey: 'statusQueryTitle' },
                    { valueId: 'statusTime', segmentId: 'statusTimeSegment', labelKey: 'statusTimeTitle' },
                    { valueId: 'statusRows', segmentId: 'statusRowsSegment', labelKey: 'statusRowsTitle' }
                ];

                if (this.statusTitleObserver) {
                    this.statusTitleObserver.disconnect();
                }

                const observer = new MutationObserver(mutations => {
                    mutations.forEach(mutation => {
                        const valueElement = mutation.target.nodeType === Node.TEXT_NODE
                            ? mutation.target.parentElement
                            : mutation.target;
                        const binding = bindings.find(item => item.valueId === valueElement?.id);
                        if (binding) this.updateStatusSegmentTitle(binding);
                    });
                });

                bindings.forEach(binding => {
                    const valueElement = document.getElementById(binding.valueId);
                    if (!valueElement) return;
                    observer.observe(valueElement, { childList: true, characterData: true, subtree: true });
                    this.updateStatusSegmentTitle(binding);
                });

                this.statusTitleObserver = observer;
            },

            updateStatusSegmentTitle({ valueId, segmentId, labelKey }) {
                const valueElement = document.getElementById(valueId);
                const segment = document.getElementById(segmentId) || valueElement?.closest('.status-segment');
                if (!valueElement || !segment) return;

                const label = this.t(labelKey);
                const value = valueElement.textContent?.trim() || '-';
                const detail = segment.dataset.statusDetail?.trim();
                const detailSuffix = detail && detail !== value ? `\n${detail}` : '';
                const title = `${label}: ${value}${detailSuffix}`;
                segment.title = title;
                valueElement.title = title;
            },

            formatCount(count, singular, plural) {
                const unit = count === 1 ? singular : plural;
                return `(${count} ${unit})`;
            },

            setCountText(element, count, singular, plural) {
                if (!element) return;
                element.dataset.count = String(count);
                element.textContent = this.formatCount(count, singular, plural);
            },

            updateStatusFromSettings() {
                const server = this.settings?.server || 'N/A';
                const database = this.settings?.database || 'N/A';
                const user = this.settings?.userId || (this.settings?.authenticationType ? 'Azure identity' : 'N/A');
                const serverSegment = document.getElementById('statusServerSegment');
                if (serverSegment) {
                    delete serverSegment.dataset.statusDetail;
                }
                document.getElementById('statusServer').textContent = server;
                document.getElementById('statusDatabase').textContent = database;
                document.getElementById('statusUser').textContent = user;
                if (this.settings?.server) {
                    document.title = `SQL Commander: ${this.settings.server}/${this.settings.database || ''}`;
                }
            },

            updateStatusFromMetadata(metadata) {
                const info = metadata?.connection;
                if (!info) {
                    this.updateStatusFromSettings();
                    return;
                }

                const server = info.serverName || this.settings?.server || 'N/A';
                const version = info.versionShort ? ` (${info.versionShort})` : '';
                const serverText = `${server}${version}`;
                const serverSegment = document.getElementById('statusServerSegment');
                if (serverSegment) {
                    serverSegment.dataset.statusDetail = info.version || '';
                }
                document.getElementById('statusServer').textContent = serverText;
                document.getElementById('statusDatabase').textContent = info.databaseName || this.settings?.database || 'N/A';
                document.getElementById('statusUser').textContent = info.userName || this.settings?.userId || 'N/A';
                this.updateStatusSegmentTitle({ valueId: 'statusServer', segmentId: 'statusServerSegment', labelKey: 'statusServerTitle' });
                document.title = `SQL Commander: ${server}/${info.databaseName || this.settings?.database || ''}`;
            },

            async copyText(value) {
                if (navigator.clipboard?.writeText) {
                    await navigator.clipboard.writeText(value);
                    return;
                }

                const textarea = document.createElement('textarea');
                textarea.value = value;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            },

            connectionStringValue(value) {
                const text = value == null ? '' : String(value);
                if (/[;"\r\n]/.test(text) || /^\s|\s$/.test(text)) {
                    return `"${text.replace(/"/g, '""')}"`;
                }
                return text;
            },

            buildConnectionStringFromSettings(settings) {
                if (!settings) return '';
                const parts = [];
                const add = (name, value, includeEmpty = false) => {
                    if (includeEmpty || (value !== undefined && value !== null && String(value) !== '')) {
                        parts.push(`${name}=${this.connectionStringValue(value)}`);
                    }
                };

                add('Data Source', settings.server);
                add('Initial Catalog', settings.database || 'annalaura');
                if (parseInt(settings.authenticationType ?? 0) === 0) {
                    add('User ID', settings.userId);
                    add('Password', settings.password);
                } else if (parseInt(settings.authenticationType ?? 0) === 2) {
                    add('Authentication', 'Active Directory Managed Identity');
                } else {
                    add('Authentication', 'Active Directory Default');
                }
                add('Pooling', settings.pooling !== false ? 'True' : 'False');
                add('MultipleActiveResultSets', settings.multipleActiveResultSets === true ? 'True' : 'False');
                add('Encrypt', settings.encrypt || 'Mandatory');
                add('TrustServerCertificate', settings.trustServerCertificate !== false ? 'True' : 'False');
                add('Application Name', settings.applicationName || 'SQL Commander');
                add('Connect Timeout', Number.isFinite(Number(settings.connectionTimeout)) ? settings.connectionTimeout : 30);
                add('Command Timeout', Number.isFinite(Number(settings.commandTimeout)) ? settings.commandTimeout : 300);
                return parts.join(';') + ';';
            },

            getDataApiOptionsFromSettingsForm() {
                return {
                    restEnabled: document.getElementById('settingDataApiRestEnabled')?.checked !== false,
                    graphQLEnabled: document.getElementById('settingDataApiGraphQLEnabled')?.checked !== false,
                    mcpEnabled: document.getElementById('settingDataApiMcpEnabled')?.checked !== false
                };
            },

            getDataApiOptionsFromDialog() {
                return {
                    restEnabled: document.getElementById('dabRestEnabled')?.checked !== false,
                    graphQLEnabled: document.getElementById('dabGraphQLEnabled')?.checked !== false,
                    mcpEnabled: document.getElementById('dabMcpEnabled')?.checked !== false
                };
            },

            getCurrentDataApiOptions() {
                return this.lastStartedDataApiOptions || {
                    restEnabled: this.settings?.dataApiRestEnabled !== false,
                    graphQLEnabled: this.settings?.dataApiGraphQLEnabled !== false,
                    mcpEnabled: this.settings?.dataApiMcpEnabled !== false
                };
            },

            getConnectionTarget() {
                const server = (this.settings?.server || '').trim();
                const database = (this.settings?.database || '').trim();

                if (server && database) {
                    return `${server} / ${database}`;
                }

                if (server) {
                    return server;
                }

                if (database) {
                    return database;
                }

                return '';
            },

            setConnectionStatus(state, { label, title } = {}) {
                const statusElement = document.getElementById('statusConnection');
                const statusBar = document.getElementById('statusBar');
                if (!statusElement) {
                    return;
                }

                const baseClass = 'status-value';
                statusElement.className = state ? `${baseClass} ${state}` : baseClass;
                if (statusBar) {
                    statusBar.classList.remove('connected', 'connecting', 'failed', 'disconnected');
                    statusBar.classList.add(state || 'disconnected');
                }

                const defaultLabels = {
                    connecting: this.t('connecting'),
                    connected: this.t('connected'),
                    failed: this.t('failed'),
                    disconnected: this.t('notConnected')
                };

                const statusLabel = label || defaultLabels[state] || this.t('status');
                const statusTitle = `${this.t('connectionStatusTitle')}: ${statusLabel}${title ? `\n${title}` : ''}`;
                statusElement.textContent = statusLabel;
                statusElement.title = statusTitle;
                document.getElementById('statusConnectionSegment')?.setAttribute('title', statusTitle);
            },

            async refreshDataApiStatus({ preserveRunning = false } = {}) {
                const previousStatus = this.dataApiStatus;
                try {
                    const response = await fetch('?handler=DataApiStatus');
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const status = await response.json();
                    this.updateDataApiStatus(status);
                    return status;
                } catch (error) {
                    console.error('Data API status error:', error);
                    const status = preserveRunning && previousStatus?.running
                        ? { ...previousStatus, success: false, state: 'failed', running: true, errorMessage: error.message || String(error) }
                        : { success: false, state: 'failed', running: false, errorMessage: error.message || String(error) };
                    this.updateDataApiStatus(status);
                    return status;
                }
            },

            startDataApiStatusPolling() {
                if (this.dataApiStatusInterval) clearInterval(this.dataApiStatusInterval);
                this.dataApiStatusInterval = setInterval(() => {
                    if (this.dataApiStatus?.running || this.dataApiStatus?.state === 'failed') {
                        this.refreshDataApiStatus();
                    }
                }, 5000);
            },

            updateDataApiStatus(status) {
                this.dataApiStatus = status || { state: 'stopped', running: false };
                const state = (this.dataApiStatus.state || (this.dataApiStatus.running ? 'running' : 'stopped')).toLowerCase();
                const segment = document.getElementById('statusDataApiSegment');
                const value = document.getElementById('statusDataApi');
                const settingsStatus = document.getElementById('settingsDataApiStatus');
                const settingsStop = document.getElementById('settingsDataApiStopBtn');

                const key = state === 'running' ? 'dataApiRunning' : state === 'failed' ? 'dataApiFailed' : state === 'starting' ? 'dataApiStarting' : 'dataApiStopped';
                const label = this.t(key);
                if (value) value.textContent = label;
                if (segment) {
                    segment.classList.remove('running', 'failed', 'stopped', 'starting');
                    segment.classList.add(state);
                    const stateLabel = label.replace(/^Data API:\s*/i, '');
                    const detail = this.dataApiStatus.baseUrl || this.dataApiStatus.errorMessage || '';
                    const action = this.dataApiStatus.running ? 'Click for runtime actions.' : 'Click to configure Data API.';
                    segment.title = `Data API status: ${stateLabel}${detail ? `\n${detail}` : ''}\n${action}`;
                }
                if (settingsStatus) {
                    settingsStatus.textContent = this.dataApiStatus.running && this.dataApiStatus.baseUrl
                        ? `Running at ${this.dataApiStatus.baseUrl}`
                        : state === 'failed'
                            ? (this.dataApiStatus.errorMessage || 'Failed')
                            : state === 'starting'
                                ? 'Starting...'
                                : 'Stopped';
                }
                if (settingsStop) settingsStop.hidden = !this.dataApiStatus.running;

                document.querySelectorAll('#dataApiStatusMenu button').forEach(button => {
                    button.disabled = !this.dataApiStatus.running;
                });
            },

            async toggleDataApiMenu(event) {
                event.stopPropagation();
                const menu = document.getElementById('dataApiStatusMenu');
                const segment = document.getElementById('statusDataApiSegment');
                if (!menu || !segment) return;
                await this.refreshDataApiStatus({ preserveRunning: this.dataApiStatus?.running === true });
                if (!this.dataApiStatus?.running) {
                    this.hideDataApiMenu();
                    this.navigateTo('/app/data-api/objects');
                    return;
                }
                const shouldShow = menu.hidden;
                menu.hidden = !shouldShow;
                if (shouldShow) {
                    const rect = segment.getBoundingClientRect();
                    menu.style.left = `${Math.max(8, rect.left)}px`;
                    menu.style.bottom = `${window.innerHeight - rect.top + 4}px`;
                    this.refreshDataApiStatus();
                }
            },

            hideDataApiMenu() {
                const menu = document.getElementById('dataApiStatusMenu');
                if (menu) menu.hidden = true;
            },

            handleDataApiStatusKeyDown(event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    this.navigateTo('/app/data-api');
                }
            },

            openDataApiUrl(kind) {
                const status = this.dataApiStatus || {};
                const baseUrl = status.baseUrl?.replace(/\/$/, '');
                const url = kind === 'health'
                    ? this.buildDataApiHealthReportUrl(status.healthUrl || (baseUrl ? `${baseUrl}/health` : null))
                    : kind === 'swagger'
                        ? status.swaggerUrl
                        : kind === 'graphql' && baseUrl
                            ? `${baseUrl}/graphql`
                            : null;
                if (url) window.open(url, '_blank', 'noopener,noreferrer');
                this.hideDataApiMenu();
            },

            async stopDataApi() {
                const dabModalOpen = document.getElementById('dabModal')?.classList.contains('show');
                const stopButtons = [
                    document.getElementById('dabRuntimeStopBtn'),
                    document.getElementById('settingsDataApiStopBtn'),
                    document.getElementById('dataApiMenuStop')
                ].filter(Boolean);
                const originalLabels = new Map(stopButtons.map(button => [button, button.textContent]));

                stopButtons.forEach(button => {
                    button.disabled = true;
                    button.textContent = 'Stopping...';
                });
                if (dabModalOpen) {
                    this.showDabRuntimePanel(this.dataApiStatus);
                }

                try {
                    const response = await fetch('?handler=StopDataApi', { method: 'POST' });
                    if (!response.ok) {
                        const text = await response.text();
                        throw new Error(text || `HTTP ${response.status} ${response.statusText}`);
                    }

                    const status = await response.json();
                    this.updateDataApiStatus(status);
                    this.hideDataApiMenu();
                    if (dabModalOpen) {
                        if (status.success === false || status.state === 'failed') {
                            this.showDabRuntimePanel(status);
                        } else if (status.running) {
                            this.showDabRuntimePanel(status);
                        } else if (this.metadata) {
                            this.showDabSelectionPanel();
                            this.restoreDabSelections(this.lastStartedDataApiSelections);
                            this.replaceRoute('/app/data-api/objects');
                        } else {
                            this.hideDabDialog();
                        }
                    }
                    return status;
                } catch (error) {
                    const status = {
                        success: false,
                        state: 'failed',
                        running: this.dataApiStatus?.running === true,
                        baseUrl: this.dataApiStatus?.baseUrl,
                        healthUrl: this.dataApiStatus?.healthUrl,
                        swaggerUrl: this.dataApiStatus?.swaggerUrl,
                        errorMessage: error.message || String(error)
                    };
                    this.updateDataApiStatus(status);
                    if (dabModalOpen) {
                        this.showDabRuntimePanel(status);
                    } else {
                        alert(`Could not stop Data API:\n\n${status.errorMessage}`);
                    }
                    return status;
                } finally {
                    stopButtons.forEach(button => {
                        button.disabled = false;
                        button.textContent = originalLabels.get(button) || 'Stop';
                    });
                }
            },

            getMermaidConfig() {
                const isLightTheme = this.settings && this.settings.theme === 'light';
                return {
                    startOnLoad: false,
                    theme: isLightTheme ? 'default' : 'dark',
                    er: {
                        useMaxWidth: true,
                        fontSize: 14,
                        layoutDirection: 'TB'
                    },
                    flowchart: {
                        useMaxWidth: true
                    }
                };
            },

            loadMermaid() {
                if (!this.mermaidPromise) {
                    this.mermaidPromise = new Promise((resolve, reject) => {
                        const initializeMermaid = () => {
                            try {
                                mermaid.initialize(this.getMermaidConfig());
                                resolve();
                            } catch (configError) {
                                reject(configError);
                            }
                        };

                        if (typeof mermaid !== 'undefined') {
                            initializeMermaid();
                            return;
                        }

                        const script = document.createElement('script');
                        script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
                        script.onload = initializeMermaid;
                        script.onerror = () => reject(new Error('Failed to load Mermaid script.'));
                        document.body.appendChild(script);
                    });
                }
                return this.mermaidPromise;
            },

            initEditor() {
                require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' }});
                require(['vs/editor/editor.main'], () => {
                    this.editor = monaco.editor.create(document.getElementById('sqlEditor'), {
                        value: this.t('editorPlaceholder'),
                        language: 'sql',
                        theme: this.settings.theme === 'light' ? 'vs' : 'vs-dark',
                        automaticLayout: true,
                        minimap: { enabled: false },
                        fontSize: 14,
                        fontFamily: 'Consolas, "Courier New", monospace',
                    });
                });
            },

            async loadSettings() {
                try {
                    const response = await fetch('?handler=Settings');
                    if (!response.ok) {
                        const text = await response.text();
                        throw new Error(`Failed to load settings. HTTP ${response.status} ${response.statusText}\n${text}`);
                    }

                    const settings = await response.json();
                    this.settings = settings;
                } catch (error) {
                    console.error('Load settings error:', error);
                    this.settings = {
                        theme: 'dark',
                        language: 'en',
                        server: '',
                        database: 'annalaura',
                        userId: '',
                        promptWhenOverwritingEditorContent: false
                    };
                    this.lastMetadataError = error;
                }

                this.language = this.settings.language || 'en';
                this.applyTheme();
                this.applyLocalization();
                this.updateStatusFromSettings();
            },

            async loadMetadata({ maxAttempts } = {}) {
                if (this.metadataLoading) {
                    return false;
                }

                const container = document.getElementById('treeContainer');
                const refreshBtn = document.getElementById('refreshMetadataBtn');
                const resultsContainer = document.getElementById('resultsContainer');

                const attempts = Math.max(1, maxAttempts ?? this.maxMetadataAttempts);
                this.metadataLoading = true;
                this.lastMetadataError = null;

                if (refreshBtn) {
                    refreshBtn.disabled = true;
                    refreshBtn.textContent = this.t('loadingMetadata');
                }

                let metadataLoaded = false;
                let lastResult = null;

                try {
                    for (let attempt = 1; attempt <= attempts; attempt++) {
                        this.showMetadataProgress(attempt, attempts);

                        const result = await this.fetchMetadataOnce();

                        if (result.success) {
                            metadataLoaded = true;
                            this.metadata = result.data;
                            break;
                        }

                        lastResult = result;
                        this.lastMetadataError = result;

                        if (attempt < attempts) {
                            await this.delay(this.metadataAttemptDelay);
                        }
                    }

                    if (metadataLoaded) {
                        this.renderTree();
                        this.updateStatusFromMetadata(this.metadata);
                        const targetText = this.getConnectionTarget();
                        const title = targetText
                            ? this.t('connectedTo').replace('{0}', targetText)
                            : this.t('connectedToDatabase');
                        this.setConnectionStatus('connected', { title });
                        if (resultsContainer && resultsContainer.querySelector('.error-block')) {
                            resultsContainer.innerHTML = `<div class="empty-state">${this.t('noResults')}</div>`;
                        }
                        return true;
                    }

                    this.metadata = null;
                    this.showMetadataFailure(lastResult, attempts);
                    const failureDetail = typeof lastResult?.message === 'string'
                        ? lastResult.message.replace(/\s+/g, ' ').trim()
                        : '';
                    const failureTitle = failureDetail ? `Last error: ${failureDetail}` : 'Failed to connect to database';
                    this.setConnectionStatus('failed', { title: failureTitle });

                    if (resultsContainer) {
                        resultsContainer.innerHTML = this.buildErrorBlockHtml(lastResult);
                    }
                    this.setStatusQuery('idle', this.t('idle'));
                    document.getElementById('statusTime').textContent = '-';
                    document.getElementById('statusRows').textContent = '-';

                    return false;
                } finally {
                    if (refreshBtn) {
                        refreshBtn.disabled = false;
                        refreshBtn.textContent = this.t('refresh');
                    }
                    this.metadataLoading = false;
                }
            },

            async fetchMetadataOnce() {
                try {
                    const response = await fetch('?handler=Metadata');
                    const text = await response.text();
                    let payload = null;

                    if (text) {
                        try {
                            payload = JSON.parse(text);
                        } catch (parseError) {
                            payload = null;
                        }
                    }

                    if (!response.ok) {
                        return {
                            success: false,
                            message: `Metadata endpoint returned HTTP ${response.status} ${response.statusText}`,
                            details: text || '(empty response)',
                            status: response.status,
                            statusText: response.statusText
                        };
                    }

                    if (!payload || typeof payload !== 'object') {
                        return {
                            success: false,
                            message: 'Unexpected response while loading metadata.',
                            details: text || '(empty response)'
                        };
                    }

                    if (!payload.success) {
                        return {
                            success: false,
                            message: payload.error || 'Server reported failure while loading metadata.',
                            details: JSON.stringify(payload, null, 2)
                        };
                    }

                    if (!payload.data) {
                        return {
                            success: false,
                            message: 'Metadata response did not include any data.',
                            details: JSON.stringify(payload, null, 2)
                        };
                    }

                    return { success: true, data: payload.data };
                } catch (error) {
                    return {
                        success: false,
                        message: error instanceof Error ? error.message : String(error),
                        details: error instanceof Error && error.stack ? error.stack : String(error)
                    };
                }
            },

            showMetadataProgress(attempt, totalAttempts) {
                const container = document.getElementById('treeContainer');
                if (!container) return;

                const targetText = this.getConnectionTarget();
                const label = this.t('connecting');
                const attemptSummary = totalAttempts > 1
                    ? this.t('connectionAttemptOf').replace('{0}', attempt).replace('{1}', totalAttempts)
                    : this.t('attemptingConnection');
                const title = targetText ? `${attemptSummary} — ${targetText}` : attemptSummary;
                this.setConnectionStatus('connecting', { label, title });

                const attemptText = this.t('connectionAttemptOf').replace('{0}', attempt).replace('{1}', totalAttempts);
                const server = this.settings?.server ? this.escapeHtml(this.settings.server) : null;
                const database = this.settings?.database ? this.escapeHtml(this.settings.database) : null;
                const target = server ? `
                        <div class="connection-message__target">${this.escapeHtml(this.t('target'))}: ${server}${database ? ` / ${database}` : ''}</div>` : '';
                container.innerHTML = `
                    <div class="connection-message">
                        <div class="connection-message__title">${this.escapeHtml(this.t('connectingToDatabase'))}</div>
                        <div class="connection-message__subtitle">${attemptText}</div>
                        ${target}
                    </div>`;
            },

            showMetadataFailure(result, attempts) {
                const container = document.getElementById('treeContainer');
                if (!container) return;

                const attemptText = `${attempts} ${attempts === 1 ? this.t('attempt') : this.t('attempts')}`;
                const message = result?.message ? this.escapeHtml(result.message) : this.escapeHtml(this.t('unknownConnectionError'));
                const troubleshooting = this.buildConnectionTroubleshootingHtml();

                container.innerHTML = `
                    <div class="connection-error">
                        <div class="connection-error__title">${this.escapeHtml(this.t('unableToConnectAfter').replace('{0}', attemptText))}</div>
                        <div class="connection-error__message">${message}</div>
                        ${troubleshooting}
                        <div class="connection-error__note">${this.escapeHtml(this.t('seeResultsPane'))}</div>
                        <div class="connection-actions">
                            <button type="button" class="primary" onclick="app.retryMetadata()">${this.escapeHtml(this.t('retry'))}</button>
                            <button type="button" class="secondary" onclick="app.navigateTo('/app/settings/connection')">${this.escapeHtml(this.t('openSettings'))}</button>
                        </div>
                    </div>`;
            },

            buildConnectionTroubleshootingHtml() {
                const settings = this.settings || {};
                const server = (settings.server || '').trim() || 'not set';
                const database = (settings.database || '').trim() || 'not set';
                const authType = parseInt(settings.authenticationType ?? 0);
                const trustServerCertificate = settings.trustServerCertificate !== false;
                const authSuggestion = authType === 0
                    ? 'Confirm SQL authentication is enabled and the SQL login/password are correct.'
                    : authType === 2
                        ? 'Confirm the hosting resource has a managed identity and that identity has Microsoft Entra and SQL permissions.'
                        : 'Confirm an Azure identity source is available here and that identity has Microsoft Entra and SQL permissions.';
                const trustSuggestion = trustServerCertificate
                    ? ''
                    : `<li><button type="button" onclick="app.navigateTo('/app/settings/connection')">Review Trust Server Certificate</button><span> — local SQL Server, containers, and self-signed certificates often need this enabled for development.</span></li>`;

                return `
                    <div class="connection-troubleshooting">
                        <div class="connection-troubleshooting__title">Troubleshooting ideas</div>
                        <ul>
                            <li><button type="button" onclick="app.navigateTo('/app/settings/connection')">Validate this is the correct server</button><span>: <code>${this.escapeHtml(server)}</code></span></li>
                            <li><button type="button" onclick="app.navigateTo('/app/settings/connection')">Validate this is the correct database</button><span>: <code>${this.escapeHtml(database)}</code></span></li>
                            <li><button type="button" onclick="app.navigateTo('/app/settings/connection')">Review authentication</button><span> — ${this.escapeHtml(authSuggestion)}</span></li>
                            ${trustSuggestion}
                            <li><button type="button" onclick="app.navigateTo('/app/settings/connection-string')">Review the generated connection string</button><span> for typos, ports, encryption, or environment-specific server names.</span></li>
                            <li><button type="button" onclick="app.navigateTo('/app/settings/connection')">Check firewall/network access</button><span> — SQL Server may need port 1433 open or an Azure SQL firewall rule for this machine/container/host.</span></li>
                        </ul>
                    </div>`;
            },

            buildErrorBlockHtml(result) {
                const message = result?.message ? this.escapeHtml(result.message) : this.escapeHtml(this.t('unknownConnectionError'));
                const details = result?.details ? this.escapeHtml(result.details) : this.escapeHtml(this.t('noAdditionalDetails'));

                return `
                    <div class="error-block">
                        <div class="error-block__title">${this.escapeHtml(this.t('databaseConnectionFailed'))}</div>
                        <div class="error-block__message">${message}</div>
                        <pre>${details}</pre>
                    </div>`;
            },

            escapeHtml(value) {
                if (value == null) return '';
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            },

            normalizeDabTypeName(value) {
                return String(value || '')
                    .trim()
                    .replace(/^\[|\]$/g, '')
                    .split('(')[0]
                    .toLowerCase();
            },

            getDabColumnTypeName(column) {
                return this.normalizeDabTypeName(column?.dataType || column?.displayType);
            },

            isDabUnsupportedColumn(column) {
                return this.dabUnsupportedSqlTypes.has(this.getDabColumnTypeName(column));
            },

            getDabUnsupportedColumns(item) {
                return (item?.columns || []).filter(col => this.isDabUnsupportedColumn(col));
            },

            getDabUnsupportedColumnsSummary(columns) {
                const shown = columns.slice(0, 5).map(col => `${col.name} (${this.getDabColumnTypeName(col)})`);
                const suffix = columns.length > shown.length ? `, +${columns.length - shown.length} more` : '';
                return shown.join(', ') + suffix;
            },

            renderDabUnsupportedIcon(title) {
                const safeTitle = this.escapeHtml(title);
                return `<span class="dab-unsupported-icon" aria-label="${safeTitle}" title="${safeTitle}">◬</span>`;
            },

            setDabOutputSummary(message = '') {
                const summary = document.getElementById('dabOutputSummary');
                if (!summary) return;

                const text = String(message || '').trim();
                summary.textContent = text;
                summary.hidden = text.length === 0;
            },

            showTestConnectionSuccess(result) {
                const button = document.getElementById('testConnectionBtn');
                if (!button) return;

                const originalText = this.t('testConnection');
                button.textContent = `✓ ${this.t('connected')}`;
                button.title = `${this.t('serverName')}: ${result.serverVersion || '-'}\n${this.t('databaseName')}: ${result.databaseName || '-'}\n${this.t('userName')}: ${result.userName || '-'}`;

                if (this.testConnectionFeedbackTimer) {
                    clearTimeout(this.testConnectionFeedbackTimer);
                }

                this.testConnectionFeedbackTimer = setTimeout(() => {
                    button.textContent = originalText;
                    button.removeAttribute('title');
                    this.testConnectionFeedbackTimer = null;
                }, 2200);
            },

            async retryMetadata() {
                await this.loadMetadata({ maxAttempts: this.maxMetadataAttempts });
            },

            renderTree() {
                const container = document.getElementById('treeContainer');
                const data = this.metadata;
                const tables = this.getVisibleObjects(data?.tables || [], 'table');
                const views = this.getVisibleObjects(data?.views || [], 'view');
                const storedProcedures = this.getVisibleObjects(data?.storedProcedures || [], 'proc');

                let html = '';

                // Tables
                if (tables.length > 0) {
                    html += this.renderCategory(tables, 'table');
                }

                // Views
                if (views.length > 0) {
                    html += this.renderCategory(views, 'view');
                }

                // Stored Procedures
                if (storedProcedures.length > 0) {
                    html += this.renderCategory(storedProcedures, 'proc');
                }

                container.innerHTML = html || `<div class="empty-state">${this.escapeHtml(this.t('noObjectsFound'))}</div>`;
                this.refreshTreeAccessibility();
                const filterValue = document.getElementById('filterInput')?.value || '';
                if (filterValue) this.filterTree(filterValue);
            },

            toggleUserObjectsOnly(checked) {
                this.showUserObjectsOnly = checked === true;
                this.renderTree();
            },

            getVisibleObjects(items, type) {
                return (items || []).filter(item => !this.isSystemObject(item) && (!this.showUserObjectsOnly || this.isCleanUserObject(item, type)));
            },

            isSystemObject(item) {
                const schema = String(item?.schema || '').toLowerCase();
                const name = String(item?.name || '').toLowerCase();
                return schema === 'sys'
                    || schema === 'information_schema'
                    || name.startsWith('sys.')
                    || name.startsWith('queue_messages_');
            },

            isCleanUserObject(item, type) {
                const name = String(item?.name || '').toLowerCase();
                const excludedNames = new Set([
                    'sysdiagrams',
                    'dtproperties',
                    '__efmigrationshistory',
                    '__migrationhistory',
                    '__refactorlog',
                    'database_firewall_rules',
                    'sp_alterdiagram',
                    'sp_creatediagram',
                    'sp_dropdiagram',
                    'sp_helpdiagramdefinition',
                    'sp_helpdiagrams',
                    'sp_renamediagram',
                    'sp_upgraddiagrams'
                ]);
                if (excludedNames.has(name) || name.startsWith('__')) {
                    return false;
                }

                if (type === 'view' && name.startsWith('sys')) {
                    return false;
                }

                return true;
            },

            getCategoryInfo(type) {
                if (type === 'table') return { titleKey: 'tables', singularKey: 'table', pluralKey: 'tablesUnit' };
                if (type === 'view') return { titleKey: 'views', singularKey: 'view', pluralKey: 'viewsUnit' };
                return { titleKey: 'storedProcedures', singularKey: 'storedProcedure', pluralKey: 'storedProceduresUnit' };
            },

            renderCategory(items, type) {
                const info = this.getCategoryInfo(type);
                const title = this.t(info.titleKey);
                const singular = this.t(info.singularKey);
                const plural = this.t(info.pluralKey);
                const isTablesCategory = type === 'table';
                const categoryClass = isTablesCategory ? 'expanded' : 'collapsed';
                
                let html = `<div class="tree-node ${categoryClass}" data-type="category" data-category-type="${type}">
                    <div class="tree-label" role="treeitem" aria-expanded="${isTablesCategory ? 'true' : 'false'}" tabindex="-1" onclick="app.selectTreeNode(event)">
                        <span class="tree-icon chevron" aria-hidden="true">❯</span>
                        <strong class="tree-name">${title}</strong> <span class="tree-count" data-unit-singular="${singular}" data-unit-plural="${plural}" data-original-count="${items.length}">${this.formatCount(items.length, singular, plural)}</span>
                    </div>
                    <div class="tree-children">`;

                // Group by schema
                const bySchema = {};
                items.forEach(item => {
                    if (!bySchema[item.schema]) bySchema[item.schema] = [];
                    bySchema[item.schema].push(item);
                });

                Object.keys(bySchema).sort().forEach(schema => {
                    const schemaCount = bySchema[schema].length;
                    html += `<div class="tree-node collapsed" data-type="schema">
                        <div class="tree-label" role="treeitem" aria-expanded="false" tabindex="-1" onclick="app.selectTreeNode(event)">
                            <span class="tree-icon chevron" aria-hidden="true">❯</span>
                            <span class="tree-name">${this.escapeHtml(schema)}</span> <span class="tree-count" data-unit-singular="${singular}" data-unit-plural="${plural}" data-original-count="${schemaCount}">${this.formatCount(schemaCount, singular, plural)}</span>
                        </div>
                        <div class="tree-children">`;

                    bySchema[schema].sort((a, b) => a.name.localeCompare(b.name)).forEach(item => {
                        const fullName = `[${item.schema}].[${item.name}]`;
                        const dabUnsupportedColumns = type === 'table' ? this.getDabUnsupportedColumns(item) : [];
                        const dabUnsupportedTitle = dabUnsupportedColumns.length > 0
                            ? `Contains Data API builder unsupported SQL type${dabUnsupportedColumns.length === 1 ? '' : 's'}: ${this.getDabUnsupportedColumnsSummary(dabUnsupportedColumns)}`
                            : '';
                        const dabUnsupportedIcon = dabUnsupportedColumns.length > 0 ? this.renderDabUnsupportedIcon(dabUnsupportedTitle) : '';
                        
                        html += `<div class="tree-node collapsed" data-type="${type}" data-fullname="${this.escapeHtml(fullName)}" data-schema="${this.escapeHtml(item.schema)}" data-name="${this.escapeHtml(item.name)}">
                            <div class="tree-label" role="treeitem" aria-expanded="false" tabindex="-1" onclick="app.selectTreeNode(event)">
                                <span class="tree-icon chevron" aria-hidden="true">❯</span>
                                <span class="tree-name tree-object-name"><span class="tree-object-label">${this.escapeHtml(item.name)}</span>${dabUnsupportedIcon}</span>
                                ${this.renderObjectActions(type)}
                            </div>
                            <div class="tree-children">`;

                        // Columns
                        if (item.columns && item.columns.length > 0) {
                            item.columns.forEach(col => {
                                const columnType = this.getDabColumnTypeName(col);
                                const columnUnsupportedIcon = this.isDabUnsupportedColumn(col)
                                    ? this.renderDabUnsupportedIcon(`Data API builder unsupported SQL type: ${columnType}`)
                                    : '';
                                html += `<div class="column-item">
                                    <span class="column-name"><span class="column-name-text">${this.escapeHtml(col.name)}</span>${columnUnsupportedIcon}</span>
                                    <span class="type-info">${this.escapeHtml(col.displayType)}</span>
                                </div>`;
                            });
                        }

                        // Parameters (for stored procedures)
                        if (item.parameters && item.parameters.length > 0) {
                            html += `<div style="margin: 8px 0 4px 16px; font-weight: 600; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">${this.t('parameters')}</div>`;
                            item.parameters.forEach(param => {
                                html += `<div class="param-item">
                                    <span>${this.escapeHtml(param.name)}</span>
                                    <span class="type-info">${this.escapeHtml(param.displayType)} (${this.escapeHtml(param.direction)})</span>
                                </div>`;
                            });
                        } else if (type === 'proc') {
                            html += `<div class="param-item">
                                <span>No parameters</span>
                            </div>`;
                        }

                        // Output columns (for stored procedures)
                        if (item.outputColumns && item.outputColumns.length > 0) {
                            html += `<div style="margin: 8px 0 4px 16px; font-weight: 600; font-size: 11px; color: var(--text-secondary); text-transform: uppercase;">${this.t('outputColumns')}</div>`;
                            item.outputColumns.forEach(col => {
                                html += `<div class="column-item">
                                    <span>${this.escapeHtml(col.name)}</span>
                                    <span class="type-info">${this.escapeHtml(col.displayType)}</span>
                                </div>`;
                            });
                        }

                        html += `</div></div>`;
                    });

                    html += `</div></div>`;
                });

                html += `</div></div>`;
                return html;
            },

            renderObjectActions(type) {
                const primary = type === 'proc' ? 'EXEC' : 'SELECT';
                const menuItems = type === 'proc'
                    ? ['create', 'drop']
                    : ['insert', 'update', 'delete', 'create', 'drop'];

                return `<span class="object-actions">
                    <button class="object-primary-action" onclick="app.handleObjectActionButton(event, '${type === 'proc' ? 'execute' : 'select'}')" title="${primary}">${primary}</button>
                    <span class="object-menu-wrap">
                        <button class="object-menu-toggle" onclick="app.toggleObjectActionMenu(event)" aria-haspopup="true" aria-expanded="false" title="More actions">⌄</button>
                        <span class="object-action-menu" role="menu">
                            ${menuItems.map(action => `<button role="menuitem" onclick="app.handleObjectActionButton(event, '${action}')">${action.toUpperCase()}</button>`).join('')}
                        </span>
                    </span>
                </span>`;
            },

            handleObjectActionButton(event, action) {
                event.stopPropagation();
                const node = event.target.closest('.tree-node[data-fullname]');
                if (!node) return;
                const fullName = node.dataset.fullname;
                const type = node.dataset.type;
                this.closeObjectMenus();

                let actionResult;
                switch (action) {
                    case 'select': actionResult = this.insertSelect(fullName, event); break;
                    case 'insert': actionResult = this.insertInsert(fullName, event); break;
                    case 'update': actionResult = this.insertUpdate(fullName, event); break;
                    case 'delete': actionResult = this.insertDelete(fullName, event); break;
                    case 'execute': actionResult = this.insertExecute(fullName, event); break;
                    case 'create': actionResult = this.insertCreate(fullName, type, event); break;
                    case 'drop': actionResult = this.insertDrop(fullName, type, event); break;
                    default: return;
                }

                this.collapseFloatingExplorer();
                return actionResult;
            },

            collapseFloatingExplorer() {
                if (this.isFloatingExplorer() && this.explorerVisible) {
                    this.toggleExplorer(false);
                }
            },

            handleFloatingExplorerOutsideClick(event) {
                if (!this.explorerVisible || !this.isFloatingExplorer()) return;

                const target = event.target instanceof Element ? event.target : null;
                if (!target) return;
                if (target.closest('#leftPane') || target.closest('#toggleExplorerBtn')) return;

                this.toggleExplorer(false);
            },

            isFloatingExplorer() {
                return window.matchMedia?.('(max-width: 900px)').matches ?? window.innerWidth <= 900;
            },

            toggleObjectActionMenu(event) {
                event.stopPropagation();
                const wrapper = event.target.closest('.object-menu-wrap');
                const wasOpen = wrapper?.classList.contains('open');
                this.closeObjectMenus();
                if (wrapper && !wasOpen) {
                    wrapper.classList.add('open');
                    event.target.setAttribute('aria-expanded', 'true');
                }
            },

            closeObjectMenus() {
                document.querySelectorAll('.object-menu-wrap.open').forEach(wrapper => {
                    wrapper.classList.remove('open');
                    wrapper.querySelector('.object-menu-toggle')?.setAttribute('aria-expanded', 'false');
                });
            },

            setNodeExpanded(node, expand) {
                if (!node) return;
                node.classList.toggle('collapsed', !expand);
                node.classList.toggle('expanded', expand);
                const label = node.querySelector(':scope > .tree-label');
                if (label) {
                    label.setAttribute('aria-expanded', String(expand));
                }
            },

            toggleNode(event) {
                event.stopPropagation();
                const node = event.target.closest('.tree-node');
                if (!node) return;
                const shouldExpand = node.classList.contains('collapsed');
                this.setNodeExpanded(node, shouldExpand);
            },

            selectTreeNode(event) {
                if (event.target.closest('button, .object-actions')) return;

                const label = event.target.closest('.tree-label');
                const node = label?.closest('.tree-node');
                if (!node) return;

                if (node.dataset.type === 'category' || node.dataset.type === 'schema') {
                    const shouldExpand = node.classList.contains('collapsed');
                    this.setNodeExpanded(node, shouldExpand);
                    return;
                }

                // Remove selection from all nodes
                document.querySelectorAll('.tree-node.selected').forEach(n => n.classList.remove('selected'));

                // Add selection to clicked node
                if (node.dataset.type === 'table' || node.dataset.type === 'view' || node.dataset.type === 'proc') {
                    node.classList.add('selected');
                    const hasChildren = !!node.querySelector(':scope > .tree-children > *');
                    if (hasChildren) {
                        const shouldExpand = node.classList.contains('collapsed');
                        this.setNodeExpanded(node, shouldExpand);
                    }
                }
            },

            refreshTreeAccessibility() {
                const labels = this.getVisibleTreeLabels();
                labels.forEach((label, index) => {
                    label.tabIndex = index === 0 ? 0 : -1;
                });
            },

            getVisibleTreeLabels() {
                return Array.from(document.querySelectorAll('#treeContainer .tree-label'))
                    .filter(label => {
                        const node = label.closest('.tree-node');
                        return node && node.offsetParent !== null && getComputedStyle(node).display !== 'none';
                    });
            },

            focusTreeLabel(label) {
                if (!label) return;
                this.getVisibleTreeLabels().forEach(item => item.tabIndex = -1);
                label.tabIndex = 0;
                label.focus({ preventScroll: false });
            },

            handleTreeKeyDown(event) {
                const currentLabel = event.target.closest('.tree-label');
                if (!currentLabel) return;

                const labels = this.getVisibleTreeLabels();
                const currentIndex = labels.indexOf(currentLabel);
                const currentNode = currentLabel.closest('.tree-node');

                switch (event.key) {
                    case 'ArrowDown':
                        event.preventDefault();
                        this.focusTreeLabel(labels[Math.min(labels.length - 1, currentIndex + 1)]);
                        break;
                    case 'ArrowUp':
                        event.preventDefault();
                        this.focusTreeLabel(labels[Math.max(0, currentIndex - 1)]);
                        break;
                    case 'Home':
                        event.preventDefault();
                        this.focusTreeLabel(labels[0]);
                        break;
                    case 'End':
                        event.preventDefault();
                        this.focusTreeLabel(labels[labels.length - 1]);
                        break;
                    case 'ArrowRight':
                        event.preventDefault();
                        if (currentNode?.classList.contains('collapsed')) {
                            this.setNodeExpanded(currentNode, true);
                        } else {
                            this.focusTreeLabel(currentNode?.querySelector(':scope > .tree-children .tree-label'));
                        }
                        break;
                    case 'ArrowLeft':
                        event.preventDefault();
                        if (currentNode?.classList.contains('expanded')) {
                            this.setNodeExpanded(currentNode, false);
                        } else {
                            const parent = currentNode?.parentElement?.closest('.tree-node');
                            this.focusTreeLabel(parent?.querySelector(':scope > .tree-label'));
                        }
                        break;
                    case 'Enter':
                    case ' ':
                        event.preventDefault();
                        currentLabel.click();
                        break;
                }
            },

            async insertSelect(fullName, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditorExecute'))) {
                    const settings = await (await fetch('?handler=Settings')).json();
                    const limit = settings.defaultResultLimit || 100;
                    
                    // Find the table in metadata to get columns
                    const [schema, name] = fullName.replace(/[\[\]]/g, '').split('.');
                    const table = this.metadata.tables.find(t => t.schema === schema && t.name === name) ||
                                  this.metadata.views.find(v => v.schema === schema && v.name === name);
                    
                    let sql = `SELECT TOP ${limit}\n`;
                    if (table && table.columns && table.columns.length > 0) {
                        table.columns.forEach((col, i) => {
                            const comma = i < table.columns.length - 1 ? ',' : '';
                            sql += `    [${col.name}]${comma}\n`;
                        });
                    } else {
                        sql += `    *\n`;
                    }
                    sql += `FROM ${fullName};`;
                    
                    this.editor.setValue(sql);
                    // Auto-execute the query
                    await this.executeQuery();
                }
            },

            insertInsert(fullName, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    // Find the table in metadata
                    const [schema, name] = fullName.replace(/[\[\]]/g, '').split('.');
                    const table = this.metadata.tables.find(t => t.schema === schema && t.name === name) ||
                                  this.metadata.views.find(v => v.schema === schema && v.name === name);
                    
                    if (!table || !table.columns) return;

                    let sql = `INSERT INTO ${fullName} (\n`;
                    table.columns.forEach((col, i) => {
                        const comma = i < table.columns.length - 1 ? ',' : '';
                        sql += `    [${col.name}]${comma}\n`;
                    });
                    sql += ')\nVALUES (\n';
                    table.columns.forEach((col, i) => {
                        const comma = i < table.columns.length - 1 ? ',' : '';
                        sql += `    NULL${comma}  -- ${col.displayType}\n`;
                    });
                    sql += ');';

                    this.editor.setValue(sql);
                }
            },

            insertUpdate(fullName, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    // Find the table in metadata
                    const [schema, name] = fullName.replace(/[\[\]]/g, '').split('.');
                    const table = this.metadata.tables.find(t => t.schema === schema && t.name === name) ||
                                  this.metadata.views.find(v => v.schema === schema && v.name === name);
                    
                    if (!table || !table.columns) return;

                    let sql = `UPDATE ${fullName}\nSET\n`;
                    table.columns.forEach((col, i) => {
                        const comma = i < table.columns.length - 1 ? ',' : '';
                        sql += `    [${col.name}] = NULL${comma}  -- ${col.displayType}\n`;
                    });
                    sql += 'WHERE 1 = 0;';

                    this.editor.setValue(sql);
                }
            },

            insertDelete(fullName, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    const sql = `DELETE FROM ${fullName}\nWHERE 1 = 0;`;
                    this.editor.setValue(sql);
                }
            },

            insertExecute(fullName, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    // Find the stored procedure in metadata
                    const [schema, name] = fullName.replace(/[\[\]]/g, '').split('.');
                    const proc = this.metadata.storedProcedures.find(p => p.schema === schema && p.name === name);
                    
                    if (!proc) return;

                    let sql = `EXEC ${fullName}`;
                    if (proc.parameters && proc.parameters.length > 0) {
                        sql += '\n';
                        proc.parameters.forEach((param, i) => {
                            const comma = i < proc.parameters.length - 1 ? ',' : '';
                            sql += `    ${param.name} = NULL${comma}\n`;
                        });
                    }
                    sql += ';';

                    this.editor.setValue(sql);
                }
            },

            insertCreate(fullName, type, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    // Find the object in metadata
                    let obj = null;
                    const [schema, name] = fullName.replace(/[\[\]]/g, '').split('.');
                    
                    if (type === 'table') {
                        obj = this.metadata.tables.find(t => t.schema === schema && t.name === name);
                    } else if (type === 'view') {
                        obj = this.metadata.views.find(v => v.schema === schema && v.name === name);
                    } else if (type === 'proc') {
                        obj = this.metadata.storedProcedures.find(p => p.schema === schema && p.name === name);
                    }

                    if (!obj) return;

                    let sql = '';
                    if (type === 'table') {
                        sql = `CREATE TABLE ${fullName} (\n`;
                        obj.columns.forEach((col, i) => {
                            const comma = i < obj.columns.length - 1 ? ',' : '';
                            const nullable = col.isNullable ? 'NULL' : 'NOT NULL';
                            sql += `    [${col.name}] ${col.displayType} ${nullable}${comma}\n`;
                        });
                        sql += ');';
                    } else if (type === 'view') {
                        sql = `CREATE VIEW ${fullName} AS\n-- View definition not available from metadata\nSELECT `;
                        obj.columns.forEach((col, i) => {
                            sql += (i > 0 ? ', ' : '') + col.name;
                        });
                        sql += '\nFROM [YourTable];';
                    } else if (type === 'proc') {
                        if (obj.definition) {
                            sql = obj.definition;
                        } else {
                            sql = `CREATE PROCEDURE ${fullName}\n`;
                            if (obj.parameters.length > 0) {
                                obj.parameters.forEach((param, i) => {
                                    const comma = i < obj.parameters.length - 1 ? ',' : '';
                                    sql += `    ${param.name} ${param.displayType}${comma}\n`;
                                });
                            }
                            sql += 'AS\nBEGIN\n    -- Procedure body not available from metadata\n    SELECT 1;\nEND;';
                        }
                    }

                    this.editor.setValue(sql);
                }
            },

            insertDrop(fullName, type, event) {
                event.stopPropagation();
                if (this.confirmEditorOverwrite(this.t('confirmOverwriteEditor'))) {
                    const objectType = type === 'table' ? 'TABLE' : type === 'view' ? 'VIEW' : 'PROCEDURE';
                    this.editor.setValue(`DROP ${objectType} ${fullName};`);
                }
            },

            confirmEditorOverwrite(message) {
                return this.settings?.promptWhenOverwritingEditorContent !== true || confirm(message);
            },

            filterTree(term) {
                term = term.toLowerCase().trim();
                const shouldFilter = term.length > 0;
                
                // Show/hide clear button
                const clearBtn = document.getElementById('clearFilterBtn');
                if (clearBtn) {
                    clearBtn.style.display = shouldFilter ? 'block' : 'none';
                }
                
                const objectNodes = document.querySelectorAll('.tree-node[data-type="table"], .tree-node[data-type="view"], .tree-node[data-type="proc"]');
                const schemaNodes = document.querySelectorAll('.tree-node[data-type="schema"]');
                const categoryNodes = document.querySelectorAll('.tree-node[data-type="category"]');
                
                // Track visible counts per schema and per category
                const schemaVisibleCounts = new Map();
                const categoryVisibleCounts = { table: 0, view: 0, proc: 0 };
                
                // Filter object nodes and count visible items per schema and category
                objectNodes.forEach(node => {
                    const objectName = (node.dataset.name || '').toLowerCase();
                    const schemaName = (node.dataset.schema || '').toLowerCase();
                    const fullName = `${schemaName}.${objectName}`;
                    
                    const isVisible = !shouldFilter || objectName.includes(term) || fullName.includes(term);
                    node.style.display = isVisible ? '' : 'none';
                    
                    // Collapse object nodes when filtering
                    if (shouldFilter && isVisible) {
                        this.setNodeExpanded(node, false);
                    }
                    
                    // Find parent schema node
                    let parent = node.parentElement;
                    while (parent && !parent.classList.contains('tree-node')) {
                        parent = parent.parentElement;
                    }
                    if (parent && parent.dataset.type === 'schema') {
                        schemaVisibleCounts.set(parent, (schemaVisibleCounts.get(parent) || 0) + (isVisible ? 1 : 0));
                    }
                    
                    // Count by category type
                    if (isVisible) {
                        const nodeType = node.dataset.type;
                        categoryVisibleCounts[nodeType] = (categoryVisibleCounts[nodeType] || 0) + 1;
                    }
                });
                
                // Update schema nodes visibility and counts
                schemaNodes.forEach(schemaNode => {
                    const visibleCount = schemaVisibleCounts.get(schemaNode) || 0;
                    const countElement = schemaNode.querySelector(':scope > .tree-label .tree-count');
                    const singular = countElement?.dataset.unitSingular || this.t('object');
                    const plural = countElement?.dataset.unitPlural || this.t('objects');
                    
                    if (!shouldFilter) {
                        // No filter: show all schemas with original counts
                        schemaNode.style.display = '';
                        const originalCount = parseInt(countElement?.dataset.originalCount || '0', 10);
                        this.setCountText(countElement, originalCount, singular, plural);
                    } else {
                        // Filter active: hide schemas with no visible items
                        if (visibleCount > 0) {
                            schemaNode.style.display = '';
                            this.setCountText(countElement, visibleCount, singular, plural);
                            // Auto-expand schema to show filtered results
                            this.setNodeExpanded(schemaNode, true);
                        } else {
                            schemaNode.style.display = 'none';
                        }
                    }
                });
                
                // Update category counts and visibility
                categoryNodes.forEach(catNode => {
                    const type = catNode.dataset.categoryType;
                    const countElement = catNode.querySelector(':scope > .tree-label .tree-count');
                    const singular = countElement?.dataset.unitSingular || this.t('object');
                    const plural = countElement?.dataset.unitPlural || this.t('objects');
                    
                    if (shouldFilter) {
                        // Filter active: update counts to show filtered results
                        const count = categoryVisibleCounts[type] || 0;
                        this.setCountText(countElement, count, singular, plural);
                        
                        // Auto-expand category if it has visible items
                        if (count > 0) {
                            this.setNodeExpanded(catNode, true);
                        }
                    } else {
                        // Reset to original counts
                        const originalCount = parseInt(countElement?.dataset.originalCount || '0', 10);
                        this.setCountText(countElement, originalCount, singular, plural);
                        
                        // Reset to default (Tables expanded, others collapsed)
                        if (type === 'table') {
                            this.setNodeExpanded(catNode, true);
                        } else {
                            this.setNodeExpanded(catNode, false);
                        }
                    }
                });
                
                // Collapse all schemas when filter is cleared
                if (!shouldFilter) {
                    schemaNodes.forEach(schemaNode => {
                        this.setNodeExpanded(schemaNode, false);
                    });
                }
                this.refreshTreeAccessibility();
            },

            clearFilter() {
                const filterInput = document.getElementById('filterInput');
                if (filterInput) {
                    filterInput.value = '';
                    this.filterTree('');
                }
            },

            async executeQuery() {
                if (this.queryRunning) return;

                const sql = this.editor.getValue().trim();
                if (!sql) return;

                this.queryRunning = true;
                this.queryCancelled = false;
                this.startTime = Date.now();
                
                const executeBtn = document.getElementById('executeBtn');
                const cancelBtn = document.getElementById('cancelBtn');
                
                executeBtn.disabled = true;
                executeBtn.style.display = 'inline-block';
                cancelBtn.style.display = 'inline-block';
                cancelBtn.disabled = false;
                cancelBtn.textContent = this.t('cancel');
                
                this.setStatusQuery('running', this.t('running'));
                document.getElementById('statusTime').textContent = '0.0s';
                document.getElementById('statusRows').textContent = '';
                document.getElementById('resultsContainer').innerHTML = '<div class="loading">Executing query...</div>';

                this.timerInterval = setInterval(() => {
                    const elapsed = Date.now() - this.startTime;
                    document.getElementById('statusTime').textContent = `${(elapsed / 1000).toFixed(1)}s`;
                }, 100);

                try {
                    const response = await fetch('?handler=ExecuteQuery', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ sql })
                    });

                    // If query was cancelled, don't process results
                    if (this.queryCancelled) {
                        return;
                    }

                    if (!response.ok) {
                        const contentType = response.headers.get('content-type');
                        const errorText = await response.text();
                        console.error('Response error details:', {
                            status: response.status,
                            statusText: response.statusText,
                            contentType: contentType,
                            body: errorText
                        });
                        
                        // Try to parse as JSON for better error messages
                        let errorMessage = errorText;
                        try {
                            const errorJson = JSON.parse(errorText);
                            if (errorJson.errorMessage) errorMessage = errorJson.errorMessage;
                            else if (errorJson.error) errorMessage = errorJson.error;
                        } catch (e) {
                            // Not JSON, use raw text
                        }
                        
                        throw new Error(`HTTP ${response.status} ${response.statusText}\n\nContent-Type: ${contentType}\n\nResponse Body:\n${errorMessage}`);
                    }

                    const text = await response.text();
                    if (!text) {
                        throw new Error('Empty response from server');
                    }

                    let result;
                    try {
                        result = JSON.parse(text);
                    } catch (parseError) {
                        console.error('JSON parse error:', parseError);
                        console.error('Response text:', text);
                        throw new Error(`Failed to parse server response as JSON.\n\nParse Error: ${parseError.message}\n\nResponse:\n${text.substring(0, 500)}`);
                    }
                    
                    // Only display results if not cancelled
                    if (!this.queryCancelled) {
                        this.displayResults(result);
                    }
                } catch (error) {
                    // Only display error if not cancelled
                    if (!this.queryCancelled) {
                        console.error('Execute query error:', error);
                        this.displayError(error.message);
                    }
                } finally {
                    // Only reset UI if query was not cancelled
                    // (cancel handler already updated the UI)
                    if (!this.queryCancelled) {
                        this.queryRunning = false;
                        clearInterval(this.timerInterval);
                        executeBtn.disabled = false;
                        cancelBtn.style.display = 'none';
                    }
                }
            },

            async cancelQuery() {
                if (!this.queryRunning) return;
                
                // Mark query as cancelled immediately
                this.queryCancelled = true;
                
                // Stop the timer immediately
                if (this.timerInterval) {
                    clearInterval(this.timerInterval);
                    this.timerInterval = null;
                }
                
                // Calculate final elapsed time
                const elapsed = Date.now() - this.startTime;
                
                // Update UI immediately - query is cancelled
                const executeBtn = document.getElementById('executeBtn');
                const cancelBtn = document.getElementById('cancelBtn');
                const statusElement = document.getElementById('statusQuery');
                
                executeBtn.disabled = false;
                cancelBtn.disabled = true;
                cancelBtn.style.display = 'none';
                statusElement.dataset.state = 'cancelled';
                statusElement.textContent = this.t('cancelled');
                document.getElementById('statusTime').textContent = `${(elapsed / 1000).toFixed(2)}s`;
                document.getElementById('statusRows').textContent = '';
                document.getElementById('resultsContainer').innerHTML = 
                    '<div style="color: var(--text-secondary); font-size: 13px;">Query cancelled by user.</div>';
                
                // Send cancellation request to server (fire and forget)
                try {
                    fetch('?handler=CancelQuery', { method: 'POST' }).catch(err => {
                        console.error('Cancel query server request failed:', err);
                    });
                } catch (error) {
                    console.error('Cancel query error:', error);
                }
                
                // Mark query as no longer running
                this.queryRunning = false;
            },

            displayResults(result) {
                const container = document.getElementById('resultsContainer');

                if (!result.success) {
                    container.innerHTML = `<div class="error">${result.errorMessage}</div>`;
                    this.setStatusQuery('failed', 'Failed');
                    document.getElementById('statusTime').textContent = `${(result.elapsedMilliseconds / 1000).toFixed(2)}s`;
                    return;
                }

                let html = '';
                
                if (result.resultSets.length === 0) {
                    html = `<div style="color: var(--text-secondary); font-size: 13px;">${this.escapeHtml(this.t('noResultsReturned'))}</div>`;
                } else {
                    // Display messages first if any
                    if (result.messages && result.messages.length > 0) {
                        html += '<div class="info-messages" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 2px; padding: 12px; margin-bottom: 12px; font-family: \'Consolas\', monospace; font-size: 12px;">';
                        html += `<div style="font-weight: 600; margin-bottom: 8px; color: var(--accent-blue);">${this.escapeHtml(this.t('messages'))}</div>`;
                        result.messages.forEach(msg => {
                            html += `<div style="margin-bottom: 4px; color: var(--text-primary);">${msg}</div>`;
                        });
                        html += '</div>';
                    }
                    
                    result.resultSets.forEach((rs, i) => {
                        html += `<div class="result-set">`;
                        if (result.resultSets.length > 1) {
                            html += `<h3>Result Set ${i + 1} (${rs.rowCount} rows)</h3>`;
                        }
                        
                        html += `<table class="result-table"><thead><tr>`;
                        rs.columns.forEach(col => {
                            html += `<th>${col}</th>`;
                        });
                        html += `</tr></thead><tbody>`;

                        rs.rows.forEach(row => {
                            html += '<tr>';
                            rs.columns.forEach(col => {
                                const val = row[col];
                                html += `<td>${val === null ? '<i>NULL</i>' : val}</td>`;
                            });
                            html += '</tr>';
                        });

                        html += `</tbody></table></div>`;
                    });
                }

                container.innerHTML = html;
                
                this.setStatusQuery('completed', this.t('completed'));
                document.getElementById('statusTime').textContent = `${(result.elapsedMilliseconds / 1000).toFixed(2)}s`;
                document.getElementById('statusRows').textContent = `${result.totalRowsReturned} rows`;
                
                if (result.wasTruncated) {
                    document.getElementById('statusRows').textContent += ' (truncated)';
                }
            },

            displayError(message) {
                // Make the error message more readable with line breaks preserved
                const formattedMessage = message.replace(/\\n/g, '<br>').replace(/\n/g, '<br>');
                document.getElementById('resultsContainer').innerHTML = `<div class="error" style="padding: 16px; white-space: pre-wrap; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px; line-height: 1.6;">${formattedMessage}</div>`;
                this.setStatusQuery('failed', 'Failed');
            },

            async showSettings(tab = 'app') {
                const modal = document.getElementById('settingsModal');
                const alreadyOpen = modal?.classList.contains('show') === true;
                if (!alreadyOpen) {
                    const response = await fetch('?handler=Settings');
                    const savedSettings = await response.json();
                    const settings = { ...savedSettings, language: this.language || savedSettings.language || 'en' };
                    this.populateSettingsForm(settings);
                }
                this.showSettingsTab(tab);
                modal?.classList.add('show');
                this.refreshConnectionStringPreview();
                await this.refreshDataApiStatus();
            },

            populateSettingsForm(settings) {
                document.getElementById('settingAuthType').value = settings.authenticationType ?? 0;
                document.getElementById('settingServer').value = settings.server || '';
                document.getElementById('settingDatabase').value = settings.database || '';
                document.getElementById('settingUserId').value = settings.userId || '';
                document.getElementById('settingPassword').value = settings.password || '';
                document.getElementById('settingPassword').type = 'password';
                document.getElementById('settingTrustServerCert').checked = settings.trustServerCertificate !== false;
                document.getElementById('settingConfirmActions').checked = settings.confirmActions === true;
                document.getElementById('settingPromptWhenOverwritingEditorContent').checked = settings.promptWhenOverwritingEditorContent === true;
                document.getElementById('settingTheme').value = settings.theme || 'dark';
                document.getElementById('settingLanguage').value = settings.language || this.language || 'en';
                document.getElementById('settingResultLimit').value = settings.defaultResultLimit || 100;
                document.getElementById('settingEncrypt').value = settings.encrypt || 'Mandatory';
                document.getElementById('settingConnectionTimeout').value = settings.connectionTimeout ?? 30;
                document.getElementById('settingCommandTimeout').value = settings.commandTimeout ?? 300;
                document.getElementById('settingApplicationName').value = !settings.applicationName || settings.applicationName === 'SQL Server Management Studio' ? 'SQL Commander' : settings.applicationName;
                document.getElementById('settingPooling').checked = settings.pooling !== false;
                document.getElementById('settingMars').checked = settings.multipleActiveResultSets === true;
                document.getElementById('settingDataApiRestEnabled').checked = settings.dataApiRestEnabled !== false;
                document.getElementById('settingDataApiGraphQLEnabled').checked = settings.dataApiGraphQLEnabled !== false;
                document.getElementById('settingDataApiMcpEnabled').checked = settings.dataApiMcpEnabled !== false;
                document.getElementById('settingConnectionStringInput').value = '';
                this.toggleAdvancedConnectionSettings(false);
                this.onAuthTypeChange();
            },

            collectSettingsFromForm() {
                return {
                    authenticationType: parseInt(document.getElementById('settingAuthType').value),
                    server: document.getElementById('settingServer').value.trim(),
                    database: document.getElementById('settingDatabase').value.trim() || 'annalaura',
                    userId: document.getElementById('settingUserId').value,
                    password: document.getElementById('settingPassword').value,
                    rememberPassword: true,
                    trustServerCertificate: document.getElementById('settingTrustServerCert').checked,
                    confirmActions: document.getElementById('settingConfirmActions').checked,
                    promptWhenOverwritingEditorContent: document.getElementById('settingPromptWhenOverwritingEditorContent').checked,
                    theme: document.getElementById('settingTheme').value,
                    language: document.getElementById('settingLanguage').value,
                    defaultResultLimit: parseInt(document.getElementById('settingResultLimit').value) || 100,
                    encrypt: document.getElementById('settingEncrypt').value,
                    connectionTimeout: parseInt(document.getElementById('settingConnectionTimeout').value) || 0,
                    commandTimeout: parseInt(document.getElementById('settingCommandTimeout').value) || 0,
                    applicationName: document.getElementById('settingApplicationName').value || 'SQL Commander',
                    pooling: document.getElementById('settingPooling').checked,
                    multipleActiveResultSets: document.getElementById('settingMars').checked,
                    connectionName: '',
                    dataApiRestEnabled: document.getElementById('settingDataApiRestEnabled').checked,
                    dataApiGraphQLEnabled: document.getElementById('settingDataApiGraphQLEnabled').checked,
                    dataApiMcpEnabled: document.getElementById('settingDataApiMcpEnabled').checked
                };
            },

            showSettingsTab(tab) {
                document.querySelectorAll('.settings-tabs button').forEach(button => button.classList.toggle('active', button.dataset.settingsTab === tab));
                document.getElementById('settingsAppPanel').classList.toggle('active', tab === 'app');
                document.getElementById('settingsPropertiesPanel').classList.toggle('active', tab === 'properties');
                document.getElementById('settingsConnectionStringPanel').classList.toggle('active', tab === 'connectionString');
                document.getElementById('settingsDataApiPanel').classList.toggle('active', tab === 'dataApi');
                document.getElementById('settingsNavigationPanel').classList.toggle('active', tab === 'navigation');
                if (tab === 'connectionString') {
                    this.refreshConnectionStringPreview();
                }
                if (tab === 'dataApi') {
                    this.refreshDataApiStatus();
                }
                if (tab === 'navigation') {
                    this.renderNavigationRoutes();
                }
            },

            toggleAdvancedConnectionSettings(force) {
                const panel = document.getElementById('advancedConnectionSettings');
                const button = document.getElementById('advancedConnectionToggle');
                if (!panel || !button) return;
                const next = typeof force === 'boolean' ? force : panel.hidden;
                panel.hidden = !next;
                button.textContent = next ? this.t('hideAdvanced') : this.t('showAdvanced');
            },

            refreshConnectionStringPreview() {
                const output = document.getElementById('settingConnectionString');
                if (!output) return;
                output.value = this.buildConnectionStringFromSettings(this.collectSettingsFromForm());
            },

            async copyConnectionString() {
                this.refreshConnectionStringPreview();
                await this.copyText(document.getElementById('settingConnectionString').value);
            },

            async parseConnectionStringIntoSettings() {
                const connectionString = document.getElementById('settingConnectionStringInput').value.trim();
                if (!connectionString) return;

                const response = await fetch('?handler=ParseConnectionString', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ connectionString })
                });
                const result = await response.json();
                if (!result.success) {
                    alert(`Could not parse connection string:\n\n${result.errorMessage}`);
                    return;
                }

                const merged = { ...this.collectSettingsFromForm(), ...result.settings };
                this.populateSettingsForm(merged);
                this.showSettingsTab('properties');
                this.refreshConnectionStringPreview();
            },

            async applySettings() {
                const settings = this.collectSettingsFromForm();
                const response = await fetch('?handler=Settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(settings)
                });
                const result = await response.json();
                if (!result.success) {
                    alert(`Could not apply settings:\n\n${result.errorMessage || response.statusText}`);
                    return;
                }

                this.settings = result.settings;
                this.language = this.settings.language || 'en';
                this.applyTheme();
                this.applyLocalization();
                this.updateStatusFromSettings();
                this.hideSettings();
                await this.loadMetadata({ maxAttempts: this.maxMetadataAttempts });
            },

            onAuthTypeChange() {
                const authType = parseInt(document.getElementById('settingAuthType')?.value ?? '0');
                const sqlAuthFields = document.getElementById('sqlAuthFields');
                const sqlPasswordField = document.getElementById('sqlPasswordField');
                const authTypeHelp = document.getElementById('authTypeHelp');
                
                if (authType === 0) {
                    if (sqlAuthFields) sqlAuthFields.style.display = 'block';
                    if (sqlPasswordField) sqlPasswordField.style.display = 'block';
                    if (authTypeHelp) authTypeHelp.textContent = this.t('sqlAuthenticationHelp');
                } else if (authType === 2) {
                    if (sqlAuthFields) sqlAuthFields.style.display = 'none';
                    if (sqlPasswordField) sqlPasswordField.style.display = 'none';
                    if (authTypeHelp) authTypeHelp.textContent = this.t('azureManagedHelp');
                } else {
                    if (sqlAuthFields) sqlAuthFields.style.display = 'none';
                    if (sqlPasswordField) sqlPasswordField.style.display = 'none';
                    if (authTypeHelp) authTypeHelp.textContent = this.t('azureDefaultHelp');
                }
                this.refreshConnectionStringPreview();
            },

            hideSettings(navigate = true) {
                document.getElementById('settingsModal').classList.remove('show');
                if (navigate && !this.applyingRoute) this.navigateTo('/app/query');
            },

            handleModalClick(event) {
                // Close modal when clicking on the backdrop (but not on the modal content)
                if (event.target.id === 'settingsModal' || event.target.id === 'schemaModal' || event.target.id === 'dabModal') {
                    this.navigateTo('/app/query');
                }
            },

            togglePasswordVisibility() {
                const passwordInput = document.getElementById('settingPassword');
                passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
            },

            async testConnection() {
                const settings = this.collectSettingsFromForm();

                try {
                    const response = await fetch('?handler=TestConnection', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(settings)
                    });

                    const responseText = await response.text();

                    if (!response.ok) {
                        let errorDetails = `HTTP ${response.status} ${response.statusText}\n\n`;
                        errorDetails += `Content-Type: ${response.headers.get('content-type') || 'null'}\n\n`;
                        errorDetails += `Response Body:\n${responseText || '(empty)'}`;
                        throw new Error(errorDetails);
                    }

                    const result = JSON.parse(responseText);
                    
                    if (result.success) {
                        this.showTestConnectionSuccess(result);
                    } else {
                        alert(`❌ Connection failed:\n\n${result.errorMessage}`);
                    }
                } catch (error) {
                    console.error('Test connection error:', error);
                    alert(`❌ Connection test failed:\n\n${error.message}`);
                }
            },

            async showDabDialog() {
                const modal = document.getElementById('dabModal');
                const wasRunning = this.dataApiStatus?.running === true;
                const currentState = (this.dataApiStatus?.state || '').toLowerCase();
                if (this.dataApiStarting || currentState === 'starting') {
                    modal?.classList.add('show');
                    this.showDabWorkingPanel('Starting Data API...');
                    return;
                }

                if (wasRunning) {
                    modal?.classList.add('show');
                    this.showDabRuntimePanel(this.dataApiStatus);
                }

                const status = await this.refreshDataApiStatus({ preserveRunning: wasRunning });
                if (status?.running) {
                    modal?.classList.add('show');
                    this.showDabRuntimePanel(status);
                    return;
                }

                if ((status?.state || '').toLowerCase() === 'failed') {
                    modal?.classList.add('show');
                    this.showDabRuntimePanel(status);
                    return;
                }

                if (!this.metadata) {
                    alert('Connect to a database before using Data API.');
                    return;
                }

                this.showDabSelectionPanel();
                modal?.classList.add('show');
            },

            showDabWorkingPanel(message = '') {
                document.getElementById('dabSelectPanel').hidden = true;
                document.getElementById('dabRuntimePanel').hidden = true;
                document.getElementById('dabWorkingPanel').hidden = false;
                document.getElementById('dabOutputPanel').hidden = true;
                document.getElementById('dabWorkingText').textContent = message || this.t('dabWorking');
                document.getElementById('dabModal')?.classList.add('show');
            },

            showDabSelectionPanel() {
                this.generatedDabConfig = '';
                this.generatedDabFileName = 'data-api.json';
                document.getElementById('dabRestEnabled').checked = this.settings?.dataApiRestEnabled !== false;
                document.getElementById('dabGraphQLEnabled').checked = this.settings?.dataApiGraphQLEnabled !== false;
                document.getElementById('dabMcpEnabled').checked = this.settings?.dataApiMcpEnabled !== false;
                document.getElementById('dabObjectFilter').value = '';
                document.getElementById('dabSelectionFilter').value = 'all';
                document.getElementById('dabSelectPanel').hidden = false;
                document.getElementById('dabRuntimePanel').hidden = true;
                document.getElementById('dabWorkingPanel').hidden = true;
                document.getElementById('dabOutputPanel').hidden = true;
                this.setDabOutputSummary('');
                this.showDabTab('objects');
                this.renderDabObjectList();
            },

            showDabRuntimePanel(status = this.dataApiStatus) {
                this.updateDataApiStatus(status || { state: 'stopped', running: false });
                document.getElementById('dabSelectPanel').hidden = true;
                document.getElementById('dabRuntimePanel').hidden = false;
                document.getElementById('dabWorkingPanel').hidden = true;
                document.getElementById('dabOutputPanel').hidden = true;

                const runtimeState = document.getElementById('dabRuntimeState');
                const current = this.dataApiStatus || {};
                const state = (current.state || (current.running ? 'running' : 'stopped')).toLowerCase();
                if (runtimeState) {
                    runtimeState.textContent = state === 'failed'
                        ? 'Data API failed'
                        : current.running ? 'Data API is running' : 'Data API is stopped';
                }
                this.renderDabRuntimeEndpoints(current);

                const stopButton = document.getElementById('dabRuntimeStopBtn');
                if (stopButton) stopButton.hidden = !current.running;
                const configureButton = document.getElementById('dabRuntimeConfigureBtn');
                if (configureButton) configureButton.hidden = current.running || !this.metadata;
                document.getElementById('dabModal').classList.add('show');
            },

            renderDabRuntimeEndpoints(status = this.dataApiStatus) {
                const container = document.getElementById('dabRuntimeEndpoints');
                if (!container) return;

                const baseUrl = status?.baseUrl?.replace(/\/$/, '');
                if (!status?.running || !baseUrl) {
                    container.innerHTML = `<div class="dab-runtime-endpoints-empty">${this.escapeHtml(this.t('endpointsAvailableAfterStart'))}</div>`;
                    return;
                }

                const options = this.getCurrentDataApiOptions();
                const appBaseUrl = baseUrl.replace(/\/data-api$/i, '');
                const mcpUrl = `${baseUrl}/mcp`;
                const mcpInstallUrl = this.buildVsCodeMcpInstallUrl(mcpUrl);
                const healthUrl = status.healthUrl || `${baseUrl}/health`;
                const endpoints = [
                    { label: 'API', url: status.swaggerUrl || `${baseUrl}/swagger`, enabled: options.restEnabled !== false },
                    { label: 'OpenAPI', url: `${appBaseUrl}/api/OpenAPI`, enabled: options.restEnabled !== false },
                    { label: 'GraphQL', url: `${baseUrl}/graphql`, enabled: options.graphQLEnabled !== false },
                    { label: 'MCP', url: mcpUrl, enabled: options.mcpEnabled !== false },
                    { label: 'VS Code', url: mcpInstallUrl, displayUrl: 'Add MCP to VS Code', enabled: options.mcpEnabled !== false },
                    { label: 'Health', url: this.buildDataApiHealthReportUrl(healthUrl), displayUrl: 'View health report', enabled: true },
                    { label: 'Docs', url: 'https://aka.ms/dab/docs', displayUrl: 'Data API documentation', enabled: true }
                ].filter(endpoint => endpoint.enabled);

                container.innerHTML = `
                    <div class="dab-runtime-endpoint-list">
                        ${endpoints.map(endpoint => `
                            <a class="dab-runtime-endpoint" href="${this.escapeHtml(endpoint.url)}" target="_blank" rel="noopener noreferrer">
                                <span class="dab-runtime-endpoint-label">${this.escapeHtml(endpoint.label)}</span>
                                <span class="dab-runtime-endpoint-url">${this.escapeHtml(endpoint.displayUrl || endpoint.url)}</span>
                            </a>`).join('')}
                    </div>`;
            },

            buildVsCodeMcpInstallUrl(mcpPath) {
                const mcpUrl = new URL(mcpPath, window.location.href).toString();
                const config = {
                    name: 'sqlCommanderDataApi',
                    type: 'http',
                    url: mcpUrl
                };
                return `vscode:mcp/install?${encodeURIComponent(JSON.stringify(config))}`;
            },

            buildDataApiHealthReportUrl(healthUrl) {
                if (!healthUrl) return null;
                const resolvedHealthUrl = new URL(healthUrl, window.location.href);
                const reportPath = resolvedHealthUrl.pathname.replace(/\/data-api\/health\/?$/i, '/data-api-health.html');
                const reportUrl = new URL(reportPath || '/data-api-health.html', resolvedHealthUrl.origin);
                reportUrl.search = resolvedHealthUrl.search;
                reportUrl.searchParams.set('url', resolvedHealthUrl.toString());
                return reportUrl.toString();
            },

            hideDabDialog(navigate = true) {
                document.getElementById('dabModal')?.classList.remove('show');
                if (navigate && !this.applyingRoute) this.navigateTo('/app/query');
            },

            renderDabObjectList() {
                const list = document.getElementById('dabObjectList');
                const groups = [
                    { title: this.t('tables'), type: 'table', items: this.metadata?.tables || [] },
                    { title: this.t('views'), type: 'view', items: this.metadata?.views || [] },
                    { title: this.t('storedProcedures'), type: 'proc', items: this.metadata?.storedProcedures || [] }
                ];

                let html = `<div class="dab-list-actions">
                    <button type="button" class="dab-link-button" onclick="app.selectAllDabObjects(true)">${this.escapeHtml(this.t('selectAll'))}</button>
                    <span aria-hidden="true">·</span>
                    <button type="button" class="dab-link-button" onclick="app.selectAllDabObjects(false)">${this.escapeHtml(this.t('selectNone'))}</button>
                    <label class="dab-user-objects-option"><input type="checkbox" id="dabShowUserObjectsOnly" ${this.showDabUserObjectsOnly ? 'checked' : ''} onchange="app.toggleDabUserObjectsOnly(this.checked)"><span>${this.escapeHtml(this.t('showUserObjectsOnly'))}</span></label>
                </div>`;
                groups.forEach(group => {
                    if (!group.items.length) return;
                    html += `<div class="dab-group" data-dab-group="${group.type}"><div class="dab-group-title">${this.escapeHtml(group.title)} <span class="dab-group-count" data-dab-group-count="${group.type}"></span></div>`;
                    group.items.forEach(item => {
                        const id = `dab_${group.type}_${item.schema}_${item.name}`.replace(/[^a-zA-Z0-9_]/g, '_');
                        const search = `${item.schema}.${item.name}`.toLowerCase();
                        const unsupportedReason = this.getUnsupportedDabObjectReason(group.type, item);
                        const isUnsupported = !!unsupportedReason;
                        const title = isUnsupported ? `${item.schema}.${item.name} — ${unsupportedReason}` : `${item.schema}.${item.name}`;
                        const warningText = this.getDabWarningText(group.type, item);
                        const disabledAttributes = isUnsupported ? ` disabled data-dab-disabled="true" aria-describedby="${id}_reason"` : ' checked';
                        html += `<label class="dab-object-row${isUnsupported ? ' disabled' : ''}" data-dab-row data-dab-search="${this.escapeHtml(search)}" data-dab-type="${group.type}" data-dab-schema="${this.escapeHtml(item.schema)}" data-dab-name="${this.escapeHtml(item.name)}" title="${this.escapeHtml(title)}">
                            <input type="checkbox" class="dab-object-checkbox" id="${id}"${disabledAttributes} onchange="app.filterDabObjects()" data-dab-type="${group.type}" data-dab-schema="${this.escapeHtml(item.schema)}" data-dab-name="${this.escapeHtml(item.name)}">
                            <span class="dab-object-name">${this.escapeHtml(item.schema)}.${this.escapeHtml(item.name)}</span>
                            ${isUnsupported ? `<span class="dab-object-warning" id="${id}_reason">${this.escapeHtml(warningText)}</span>` : ''}
                            ${!isUnsupported && group.type === 'view' ? this.renderDabViewKeyFields(id, item) : ''}
                        </label>`;
                    });
                    html += '</div>';
                });
                list.innerHTML = html || `<div class="empty-state">${this.escapeHtml(this.t('noObjectsFound'))}</div>`;
                this.filterDabObjects();
            },

            toggleDabUserObjectsOnly(checked) {
                this.showDabUserObjectsOnly = checked === true;
                this.filterDabObjects();
            },

            getDabWarningText(type, item) {
                if (this.getUnsupportedDabDataTypes(type, item).length > 0) return this.t('unsupportedType');
                if (type === 'table') return this.t('needsPrimaryKey');
                return '';
            },

            renderDabViewKeyFields(id, item) {
                const columns = Array.isArray(item?.columns) ? item.columns : [];
                if (columns.length === 0) return `<span class="dab-object-warning">${this.escapeHtml(this.t('noColumns'))}</span>`;

                const keyOptions = columns.map(column => {
                    const columnName = column?.name || '';
                    const isDefaultKey = column?.isPrimaryKey === true || columnName.toLowerCase() === 'id';
                    const title = this.t('useAsDataApiKeyField').replace('{0}', columnName);
                    return `<span class="dab-view-key-option" title="${this.escapeHtml(title)}">
                        <input type="checkbox" data-dab-key-field="true" value="${this.escapeHtml(columnName)}" ${isDefaultKey ? 'checked' : ''} onchange="app.filterDabObjects()">
                        <span>${this.escapeHtml(columnName)}</span>
                    </span>`;
                }).join('');

                return `<span class="dab-view-key-fields" id="${id}_keys"><span class="dab-view-key-label">${this.escapeHtml(this.t('key'))}</span>${keyOptions}</span>`;
            },

            getUnsupportedDabObjectReason(type, item) {
                const unsupportedTypes = this.getUnsupportedDabDataTypes(type, item);
                if (unsupportedTypes.length > 0) {
                    return this.t('dabUnsupportedTypeReason').replace('{0}', unsupportedTypes.join(', '));
                }

                if (type !== 'table') return '';
                const columns = Array.isArray(item?.columns) ? item.columns : [];
                const hasPrimaryKey = columns.some(column => column?.isPrimaryKey === true);
                return hasPrimaryKey ? '' : this.t('dabTablePrimaryKeyReason');
            },

            getUnsupportedDabDataTypes(type, item) {
                const dataTypes = [
                    ...(Array.isArray(item?.columns) ? item.columns : []),
                    ...(Array.isArray(item?.parameters) ? item.parameters : []),
                    ...(Array.isArray(item?.outputColumns) ? item.outputColumns : [])
                ]
                    .map(field => (field?.dataType || '').toLowerCase())
                    .filter(dataType => this.dabUnsupportedSqlTypes.has(dataType));

                return [...new Set(dataTypes)].sort();
            },

            filterDabObjects() {
                const term = (document.getElementById('dabObjectFilter')?.value || '').trim().toLowerCase();
                const selectedFilter = document.getElementById('dabSelectionFilter')?.value || 'all';
                document.querySelectorAll('[data-dab-row]').forEach(row => {
                    const checkbox = row.querySelector('.dab-object-checkbox');
                    const item = {
                        schema: row.dataset.dabSchema || checkbox?.dataset.dabSchema || '',
                        name: row.dataset.dabName || checkbox?.dataset.dabName || ''
                    };
                    const type = row.dataset.dabType || checkbox?.dataset.dabType || '';
                    const matchesUserObjectFilter = !this.showDabUserObjectsOnly || (!this.isSystemObject(item) && this.isCleanUserObject(item, type));
                    const matchesText = !term || (row.dataset.dabSearch || '').includes(term);
                    const matchesSelection = selectedFilter === 'all' || (selectedFilter === 'selected' ? checkbox?.checked : !checkbox?.checked);
                    row.dataset.dabUserObjectMatch = matchesUserObjectFilter ? 'true' : 'false';
                    row.hidden = !(matchesUserObjectFilter && matchesText && matchesSelection);
                });
                this.updateDabGroupCounts();
                this.updateDabStartButtonState();
            },

            updateDabGroupCounts() {
                document.querySelectorAll('[data-dab-group]').forEach(group => {
                    const type = group.dataset.dabGroup;
                    const selectedCount = Array.from(group.querySelectorAll(`.dab-object-checkbox[data-dab-type="${type}"]:checked`))
                        .filter(input => input.closest('[data-dab-row]')?.dataset.dabUserObjectMatch !== 'false')
                        .length;
                    const count = group.querySelector('[data-dab-group-count]');
                    if (count) count.textContent = `(${selectedCount} ${this.t('selectedUnit')})`;
                });
            },

            updateDabStartButtonState() {
                const startButton = document.getElementById('dabStartButton');
                if (!startButton) return;

                const selectedCount = Array.from(document.querySelectorAll('#dabObjectList .dab-object-checkbox:checked'))
                    .filter(input => input.closest('[data-dab-row]')?.dataset.dabUserObjectMatch !== 'false')
                    .length;
                const keyErrors = this.getSelectedViewKeyErrors();
                startButton.disabled = selectedCount === 0 || keyErrors.length > 0;
                startButton.title = keyErrors.length > 0
                    ? this.t('selectKeyFieldsFor').replace('{0}', keyErrors.join(', '))
                    : selectedCount === 0
                    ? this.t('selectAtLeastOneDataApiObject')
                    : this.t('startDataApiWithSelectedObjects')
                        .replace('{0}', selectedCount)
                        .replace('{1}', selectedCount === 1 ? this.t('object') : this.t('objects'));
            },

            getSelectedViewKeyErrors() {
                return Array.from(document.querySelectorAll('#dabObjectList .dab-object-checkbox[data-dab-type="view"]:checked'))
                    .filter(input => input.closest('[data-dab-row]')?.dataset.dabUserObjectMatch !== 'false')
                    .filter(input => this.getDabViewKeyFields(input).length === 0)
                    .map(input => `${input.dataset.dabSchema}.${input.dataset.dabName}`);
            },

            showDabTab(tab) {
                document.getElementById('dabObjectsPanel')?.classList.add('active');
            },

            selectAllDabObjects(checked) {
                document.querySelectorAll('#dabObjectList .dab-object-checkbox:not(:disabled)').forEach(input => {
                    input.checked = checked;
                });
                this.filterDabObjects();
            },

            getSelectedDabObjects() {
                return Array.from(document.querySelectorAll('#dabObjectList .dab-object-checkbox:checked:not(:disabled)'))
                    .filter(input => input.closest('[data-dab-row]')?.dataset.dabUserObjectMatch !== 'false')
                    .map(input => ({
                        type: input.dataset.dabType,
                        schema: input.dataset.dabSchema,
                        name: input.dataset.dabName,
                        keyFields: input.dataset.dabType === 'view' ? this.getDabViewKeyFields(input) : []
                    }));
            },

            getDabViewKeyFields(viewInput) {
                const row = viewInput?.closest('[data-dab-row]');
                if (!row) return [];

                return Array.from(row.querySelectorAll('input[data-dab-key-field="true"]:checked'))
                    .map(input => input.value)
                    .filter(Boolean);
            },

            restoreDabSelections(selections) {
                if (!Array.isArray(selections) || selections.length === 0) return;

                const selectedKeys = new Set(selections.map(selection => `${selection.type}|${selection.schema}|${selection.name}`.toLowerCase()));
                document.querySelectorAll('#dabObjectList .dab-object-checkbox').forEach(input => {
                    const key = `${input.dataset.dabType}|${input.dataset.dabSchema}|${input.dataset.dabName}`.toLowerCase();
                    input.checked = !input.disabled && selectedKeys.has(key);

                    if (input.dataset.dabType === 'view') {
                        const selection = selections.find(item => `${item.type}|${item.schema}|${item.name}`.toLowerCase() === key);
                        const keyFields = new Set((selection?.keyFields || []).map(field => field.toLowerCase()));
                        input.closest('[data-dab-row]')?.querySelectorAll('input[data-dab-key-field="true"]').forEach(keyInput => {
                            keyInput.checked = keyFields.size === 0 ? keyInput.checked : keyFields.has(keyInput.value.toLowerCase());
                        });
                    }
                });
                this.filterDabObjects();
            },

            async generateDabConfig() {
                const selections = this.getSelectedDabObjects();
                if (selections.length === 0) {
                    alert(this.t('selectAtLeastOneObject'));
                    return;
                }

                this.showDabWorkingPanel(this.t('dabWorking'));
                document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = false);
                document.getElementById('dabDiagnosticsDetails').hidden = true;
                document.getElementById('dabDiagnosticsOutput').textContent = '';
                this.setDabOutputSummary('');

                try {
                    const response = await fetch('?handler=GenerateDabConfig', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ selections, ...this.getDataApiOptionsFromDialog() })
                    });
                    const result = await response.json();

                    document.getElementById('dabWorkingPanel').hidden = true;
                    document.getElementById('dabOutputPanel').hidden = false;

                    if (!result.success) {
                        this.generatedDabConfig = '';
                        this.setDabOutputSummary('Data API config generation failed.');
                        document.getElementById('dabConfigOutput').textContent = result.diagnostics || result.errorMessage || '';
                        document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                        document.getElementById('dabDiagnosticsDetails').hidden = true;
                        return;
                    }

                    this.generatedDabConfig = result.configJson || '';
                    this.generatedDabFileName = result.fileName || 'data-api.json';
                    this.setDabOutputSummary('');
                    document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = false);
                    this.renderJsonOutput('dabConfigOutput', this.generatedDabConfig);
                    const diagnostics = document.getElementById('dabDiagnosticsDetails');
                    const diagnosticsOutput = document.getElementById('dabDiagnosticsOutput');
                    diagnostics.hidden = !result.diagnostics;
                    diagnosticsOutput.textContent = result.diagnostics || '';
                } catch (error) {
                    document.getElementById('dabWorkingPanel').hidden = true;
                    document.getElementById('dabOutputPanel').hidden = false;
                    this.setDabOutputSummary('Data API config generation failed.');
                    document.getElementById('dabConfigOutput').textContent = error.message || String(error);
                    document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                    document.getElementById('dabDiagnosticsDetails').hidden = true;
                }
            },

            async startDataApi() {
                if (this.dataApiStarting) {
                    this.showDabWorkingPanel('Starting Data API...');
                    return;
                }

                const selections = this.getSelectedDabObjects();
                if (selections.length === 0) {
                    alert(this.t('selectAtLeastOneObject'));
                    return;
                }
                const dataApiOptions = this.getDataApiOptionsFromDialog();
                this.lastStartedDataApiOptions = dataApiOptions;
                this.lastStartedDataApiSelections = selections;
                this.dataApiStarting = true;

                this.showDabWorkingPanel('Starting Data API...');
                document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                document.getElementById('dabDiagnosticsDetails').hidden = true;
                document.getElementById('dabDiagnosticsOutput').textContent = '';
                this.setDabOutputSummary('');
                this.updateDataApiStatus({ state: 'starting', running: false });

                try {
                    const response = await fetch('?handler=StartDataApi', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ selections, ...dataApiOptions })
                    });
                    const status = await response.json();
                    this.updateDataApiStatus(status);

                    if (!status.success || status.state === 'failed') {
                        document.getElementById('dabWorkingPanel').hidden = true;
                        document.getElementById('dabOutputPanel').hidden = false;
                        this.setDabOutputSummary('Data API failed to start.');
                        document.getElementById('dabConfigOutput').textContent = status.diagnostics || status.errorMessage || '';
                        document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                        document.getElementById('dabDiagnosticsDetails').hidden = true;
                        return;
                    }

                    if (status.running) {
                        this.showDabRuntimePanel(status);
                        if (!this.applyingRoute) this.navigateTo('/app/data-api/running');
                        return;
                    }

                    document.getElementById('dabWorkingPanel').hidden = true;
                    document.getElementById('dabOutputPanel').hidden = false;
                    this.setDabOutputSummary('');
                    document.getElementById('dabConfigOutput').textContent = status.diagnostics || '';
                    document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                    document.getElementById('dabDiagnosticsDetails').hidden = true;
                } catch (error) {
                    document.getElementById('dabWorkingPanel').hidden = true;
                    document.getElementById('dabOutputPanel').hidden = false;
                    this.setDabOutputSummary('Data API failed to start.');
                    document.getElementById('dabConfigOutput').textContent = error.message || String(error);
                    document.querySelectorAll('[data-dab-config-action]').forEach(button => button.hidden = true);
                    document.getElementById('dabDiagnosticsDetails').hidden = true;
                    this.updateDataApiStatus({ state: 'failed', running: false, errorMessage: error.message || String(error) });
                } finally {
                    this.dataApiStarting = false;
                }
            },

            backToDabSelection() {
                if (this.metadata) {
                    this.showDabSelectionPanel();
                    if (!this.applyingRoute) this.navigateTo('/app/data-api/objects');
                }
            },

            renderJsonOutput(elementId, value) {
                const element = document.getElementById(elementId);
                if (!element) return;
                let json = value || '';
                try {
                    json = JSON.stringify(JSON.parse(json), null, 2);
                } catch {
                    element.textContent = json;
                    return;
                }

                element.innerHTML = json.replace(/("(?:\\u[a-fA-F0-9]{4}|\\[^u]|[^\\"])*"\s*:)|("(?:\\u[a-fA-F0-9]{4}|\\[^u]|[^\\"])*")|\b(true|false)\b|\b(null)\b|(-?\d+(?:\.\d+)?(?:[eE][+\-]?\d+)?)/g,
                    (match, key, stringValue, boolValue, nullValue, numberValue) => {
                        const escaped = this.escapeHtml(match);
                        if (key) return `<span class="json-key">${escaped}</span>`;
                        if (stringValue) return `<span class="json-string">${escaped}</span>`;
                        if (boolValue) return `<span class="json-boolean">${escaped}</span>`;
                        if (nullValue) return `<span class="json-null">${escaped}</span>`;
                        if (numberValue) return `<span class="json-number">${escaped}</span>`;
                        return escaped;
                    });
            },

            async copyDabConfig(button = document.querySelector('[data-dab-copy-button]')) {
                if (!this.generatedDabConfig) return;

                const copyButton = button || document.querySelector('[data-dab-copy-button]');
                const originalText = copyButton?.dataset.originalText || copyButton?.textContent || this.t('copy');
                if (copyButton) copyButton.dataset.originalText = originalText;

                try {
                    await this.copyText(this.generatedDabConfig);
                    if (copyButton) {
                        copyButton.textContent = '✓ Copied';
                        copyButton.classList.add('dab-copy-confirmed');
                        copyButton.setAttribute('aria-live', 'polite');
                    }
                } catch (error) {
                    if (copyButton) {
                        copyButton.textContent = 'Copy failed';
                        copyButton.classList.add('dab-copy-failed');
                    }
                    throw error;
                } finally {
                    if (this.dabCopyFeedbackTimer) clearTimeout(this.dabCopyFeedbackTimer);
                    this.dabCopyFeedbackTimer = setTimeout(() => {
                        if (copyButton) {
                            copyButton.textContent = originalText;
                            copyButton.classList.remove('dab-copy-confirmed', 'dab-copy-failed');
                            copyButton.removeAttribute('aria-live');
                        }
                        this.dabCopyFeedbackTimer = null;
                    }, 1200);
                }
            },

            downloadDabConfig() {
                if (!this.generatedDabConfig) return;
                const blob = new Blob([this.generatedDabConfig], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const anchor = document.createElement('a');
                anchor.href = url;
                anchor.download = this.generatedDabFileName;
                document.body.appendChild(anchor);
                anchor.click();
                anchor.remove();
                URL.revokeObjectURL(url);
            },

            async refreshMetadata() {
                await this.loadMetadata({ maxAttempts: this.maxMetadataAttempts });
            },

            async showSchema() {
                console.log('showSchema called');
                
                // Load Mermaid library
                try {
                    await this.loadMermaid();
                    console.log('Mermaid loaded successfully');
                } catch (error) {
                    console.error('Failed to load Mermaid:', error);
                    const message = error instanceof Error ? error.message : error;
                    alert('Failed to load diagram library: ' + message);
                    return;
                }

                // Show modal immediately
                const modal = document.getElementById('schemaModal');
                const container = document.getElementById('schemaContainer');
                
                modal.classList.add('show');
                container.innerHTML = '<div class="loading">Generating diagram...</div>';

                // Check if we have tables
                if (!this.metadata || !this.metadata.tables || this.metadata.tables.length === 0) {
                    container.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-secondary);">No tables found in the database.</div>';
                    return;
                }

                console.log('Generating ERD for', this.metadata.tables.length, 'tables');

                // Configure Mermaid theme so subsequent renders stay in sync with the current UI settings.
                try {
                    mermaid.initialize(this.getMermaidConfig());
                } catch (error) {
                    console.error('Mermaid initialization error:', error);
                }

                // Build the ERD diagram
                let erd = '---\nconfig:\n  er:\n    layoutDirection: TB\n---\nerDiagram\n';
                const processedTables = new Set();
                
                // Add tables with relationships first
                if (this.metadata.foreignKeys && this.metadata.foreignKeys.length > 0) {
                    console.log('Processing', this.metadata.foreignKeys.length, 'foreign keys');
                    
                    this.metadata.foreignKeys.forEach(fk => {
                        const parentKey = `${fk.parentSchema}_${fk.parentTable}`;
                        const refKey = `${fk.referencedSchema}_${fk.referencedTable}`;
                        
                        // Add parent table if not already added
                        if (!processedTables.has(parentKey)) {
                            const table = this.metadata.tables.find(t => 
                                t.schema === fk.parentSchema && t.name === fk.parentTable
                            );
                            if (table) {
                                erd += `    ${parentKey} {\n`;
                                table.columns.slice(0, 10).forEach(col => {
                                    const safeColName = col.name.replace(/[^a-zA-Z0-9_]/g, '_');
                                    const typeInfo = col.dataType || 'string';
                                    erd += `        ${typeInfo} ${safeColName}\n`;
                                });
                                if (table.columns.length > 10) {
                                    erd += `        string more_columns "..."\n`;
                                }
                                erd += `    }\n`;
                                processedTables.add(parentKey);
                            }
                        }
                        
                        // Add referenced table if not already added
                        if (!processedTables.has(refKey)) {
                            const table = this.metadata.tables.find(t => 
                                t.schema === fk.referencedSchema && t.name === fk.referencedTable
                            );
                            if (table) {
                                erd += `    ${refKey} {\n`;
                                table.columns.slice(0, 10).forEach(col => {
                                    const safeColName = col.name.replace(/[^a-zA-Z0-9_]/g, '_');
                                    const typeInfo = col.dataType || 'string';
                                    erd += `        ${typeInfo} ${safeColName}\n`;
                                });
                                if (table.columns.length > 10) {
                                    erd += `        string more_columns "..."\n`;
                                }
                                erd += `    }\n`;
                                processedTables.add(refKey);
                            }
                        }
                        
                        // Add relationship
                        erd += `    ${parentKey} ||--o{ ${refKey} : "${fk.name}"\n`;
                    });
                }
                
                // Add remaining standalone tables
                this.metadata.tables.forEach(table => {
                    const tableKey = `${table.schema}_${table.name}`;
                    if (!processedTables.has(tableKey)) {
                        erd += `    ${tableKey} {\n`;
                        table.columns.slice(0, 10).forEach(col => {
                            const safeColName = col.name.replace(/[^a-zA-Z0-9_]/g, '_');
                            const typeInfo = col.dataType || 'string';
                            const nullInfo = col.isNullable ? '' : ' "NOT NULL"';
                            erd += `        ${typeInfo} ${safeColName}${nullInfo}\n`;
                        });
                        if (table.columns.length > 10) {
                            erd += `        string more_columns "..."\n`;
                        }
                        erd += `    }\n`;
                        processedTables.add(tableKey);
                    }
                });

                console.log('Generated ERD:\n', erd);

                // Render the diagram
                try {
                    // Give the DOM a moment to update
                    await new Promise(resolve => setTimeout(resolve, 50));
                    
                    const { svg, bindFunctions } = await mermaid.render('schemaDiagram_' + Date.now(), erd);
                    container.innerHTML = svg;
                    bindFunctions?.(container);
                    console.log('Diagram rendered successfully');

                    const svgElement = container.querySelector('svg');
                    if (svgElement) {
                        // Normalize the SVG viewBox so we can work with the actual rendered bounds
                        const bbox = svgElement.getBBox();
                        const padding = 32;
                        const viewBoxX = bbox.x - padding;
                        const viewBoxY = bbox.y - padding;
                        const viewBoxWidth = Math.max(1, bbox.width + padding * 2);
                        const viewBoxHeight = Math.max(1, bbox.height + padding * 2);

                        svgElement.setAttribute('viewBox', `${viewBoxX} ${viewBoxY} ${viewBoxWidth} ${viewBoxHeight}`);
                        svgElement.removeAttribute('width');
                        svgElement.removeAttribute('height');

                        // Store baseline dimensions derived from the cleaned viewBox
                        this.baseSchemaWidth = viewBoxWidth;
                        this.baseSchemaHeight = viewBoxHeight;

                        // Auto-fit to container based on dominant orientation
                        const containerWidth = Math.max(200, (container.clientWidth || container.offsetWidth || viewBoxWidth) - 40);
                        const containerHeight = Math.max(200, (container.clientHeight || container.offsetHeight || viewBoxHeight) - 40);

                        const diagramAspectRatio = viewBoxWidth / viewBoxHeight;
                        const containerAspectRatio = containerWidth / containerHeight;

                        if (diagramAspectRatio < containerAspectRatio) {
                            // Diagram is taller/narrower - fit to height
                            this.currentSchemaScale = containerHeight / viewBoxHeight;
                        } else {
                            // Diagram is wider/shorter - fit to width
                            this.currentSchemaScale = containerWidth / viewBoxWidth;
                        }

                        if (this.currentSchemaScale < 0.2) {
                            // Large disconnected schemas can render as a wide strip.
                            // Prefer a readable starting scale with scrolling over a tiny fit-to-window view.
                            const readableWideScale = Math.min(0.4, Math.max(0.2, containerHeight / viewBoxHeight));
                            this.currentSchemaScale = Math.max(this.currentSchemaScale, readableWideScale);
                        }

                        const scaledWidth = viewBoxWidth * this.currentSchemaScale;
                        const scaledHeight = viewBoxHeight * this.currentSchemaScale;

                        svgElement.style.width = `${scaledWidth}px`;
                        svgElement.style.height = `${scaledHeight}px`;
                        svgElement.style.maxWidth = 'none';
                        
                        // Update zoom level display
                        const zoomDisplay = document.getElementById('zoomLevel');
                        if (zoomDisplay) {
                            zoomDisplay.textContent = `${Math.round(this.currentSchemaScale * 100)}%`;
                        }
                        
                        // Setup pan and zoom controls
                        this.setupSchemaPanAndZoom();
                        
                        // Show hint overlay briefly
                        const hint = document.getElementById('schemaHint');
                        if (hint) {
                            hint.style.opacity = '1';
                            setTimeout(() => {
                                hint.style.opacity = '0';
                            }, 3500);
                        }
                        console.log(`Schema diagram base dimensions set to ${viewBoxWidth.toFixed(0)}x${viewBoxHeight.toFixed(0)}. Rendered at ${Math.round(this.currentSchemaScale * 100)}% scale.`);
                    }
                } catch (renderError) {
                    console.error('Mermaid render error:', renderError);
                    container.innerHTML = `
                        <div class="error" style="padding: 20px;">
                            <strong>Could not render schema diagram</strong><br><br>
                            <pre style="overflow: auto; max-height: 300px;">${renderError.message || renderError}</pre>
                            <br>
                            <details style="margin-top: 10px;">
                                <summary style="cursor: pointer;">View ERD Definition</summary>
                                <pre style="overflow: auto; max-height: 300px; margin-top: 10px;">${erd}</pre>
                            </details>
                        </div>
                    `;
                }
            },

            zoomSchema(factor) {
                const container = document.getElementById('schemaContainer');
                const svgElement = container.querySelector('svg');
                
                if (!svgElement) return;
                
                if (factor === 'reset') {
                    this.currentSchemaScale = 2.5;
                } else if (factor === 'fit') {
                    if (!this.baseSchemaWidth || !this.baseSchemaHeight) {
                        const box = svgElement.viewBox?.baseVal;
                        if (box) {
                            this.baseSchemaWidth = box.width;
                            this.baseSchemaHeight = box.height;
                        } else {
                            const fallbackBox = svgElement.getBBox();
                            this.baseSchemaWidth = fallbackBox.width || 1;
                            this.baseSchemaHeight = fallbackBox.height || 1;
                        }
                    }

                    const originalWidth = this.baseSchemaWidth;
                    const originalHeight = this.baseSchemaHeight;

                    const containerWidth = Math.max(200, (container.clientWidth || container.offsetWidth || originalWidth) - 40);
                    const containerHeight = Math.max(200, (container.clientHeight || container.offsetHeight || originalHeight) - 40);

                    const diagramAspectRatio = originalWidth / originalHeight;
                    const containerAspectRatio = containerWidth / containerHeight;

                    if (diagramAspectRatio < containerAspectRatio) {
                        // Diagram is taller/narrower - fit to height
                        this.currentSchemaScale = containerHeight / originalHeight;
                    } else {
                        // Diagram is wider/shorter - fit to width
                        this.currentSchemaScale = containerWidth / originalWidth;
                    }
                } else {
                    this.currentSchemaScale *= factor;
                    this.currentSchemaScale = Math.max(0.1, Math.min(25, this.currentSchemaScale));
                }
                
                const scaledWidth = Math.max(1, this.baseSchemaWidth * this.currentSchemaScale);
                const scaledHeight = Math.max(1, this.baseSchemaHeight * this.currentSchemaScale);
                svgElement.style.width = `${scaledWidth}px`;
                svgElement.style.height = `${scaledHeight}px`;
                
                // Update zoom level display
                const zoomDisplay = document.getElementById('zoomLevel');
                if (zoomDisplay) {
                    zoomDisplay.textContent = `${Math.round(this.currentSchemaScale * 100)}%`;
                }
                
                console.log(`Zoom adjusted to ${(this.currentSchemaScale * 100).toFixed(0)}%`);
            },

            setupSchemaPanAndZoom() {
                const container = document.getElementById('schemaContainer');
                if (!container) return;

                // Mouse wheel zoom with Ctrl key
                container.addEventListener('wheel', (e) => {
                    if (e.ctrlKey) {
                        e.preventDefault();
                        const zoomFactor = e.deltaY < 0 ? 1.15 : 0.85;
                        this.zoomSchema(zoomFactor);
                    }
                }, { passive: false });

                // Panning with mouse drag
                container.addEventListener('mousedown', (e) => {
                    // Only pan if clicking on the container background, not the SVG content
                    if (e.target === container || e.target.closest('svg')) {
                        this.isPanning = true;
                        this.panStart = { x: e.clientX, y: e.clientY };
                        this.scrollStart = { x: container.scrollLeft, y: container.scrollTop };
                        container.style.cursor = 'grabbing';
                        e.preventDefault();
                    }
                });

                container.addEventListener('mousemove', (e) => {
                    if (this.isPanning) {
                        const dx = e.clientX - this.panStart.x;
                        const dy = e.clientY - this.panStart.y;
                        container.scrollLeft = this.scrollStart.x - dx;
                        container.scrollTop = this.scrollStart.y - dy;
                    }
                });

                const stopPanning = () => {
                    if (this.isPanning) {
                        this.isPanning = false;
                        container.style.cursor = 'grab';
                    }
                };

                container.addEventListener('mouseup', stopPanning);
                container.addEventListener('mouseleave', stopPanning);

                // Set cursor style
                container.style.cursor = 'grab';

                // Keyboard shortcuts for zoom
                const keyHandler = (e) => {
                    if (document.getElementById('schemaModal').classList.contains('show')) {
                        if (e.key === '+' || e.key === '=') {
                            e.preventDefault();
                            this.zoomSchema(1.5);
                        } else if (e.key === '-' || e.key === '_') {
                            e.preventDefault();
                            this.zoomSchema(0.75);
                        } else if (e.key === '0') {
                            e.preventDefault();
                            this.zoomSchema('reset');
                        } else if (e.key === 'f' || e.key === 'F') {
                            e.preventDefault();
                            this.zoomSchema('fit');
                        }
                    }
                };

                document.removeEventListener('keydown', this.schemaKeyHandler);
                this.schemaKeyHandler = keyHandler;
                document.addEventListener('keydown', keyHandler);
            },

            hideSchema(navigate = true) {
                document.getElementById('schemaModal').classList.remove('show');
                if (navigate && !this.applyingRoute) this.navigateTo('/app/query');
            },

            setupKeyboardShortcuts() {
                document.addEventListener('keydown', (e) => {
                    const key = e.key.toLowerCase();
                    if (e.key === 'Escape') {
                        this.closeObjectMenus();
                        this.navigateTo('/app/query');
                        if (this.queryRunning) this.cancelQuery();
                        return;
                    }

                    if (e.ctrlKey && key === 'e') {
                        e.preventDefault();
                        this.executeQuery();
                    } else if (e.ctrlKey && key === 'r') {
                        e.preventDefault();
                        this.toggleResultsPane();
                    } else if (e.ctrlKey && key === 'b') {
                        e.preventDefault();
                        this.toggleExplorer();
                    } else if (e.ctrlKey && key === ',') {
                        e.preventDefault();
                        this.navigateTo('/app/settings/app');
                    } else if (e.ctrlKey && e.shiftKey && key === 's') {
                        e.preventDefault();
                        this.navigateTo('/app/diagram');
                    } else if (e.ctrlKey && e.shiftKey && key === 'd') {
                        e.preventDefault();
                        this.navigateTo('/app/data-api/objects');
                    } else if (e.ctrlKey && key === 'f') {
                        e.preventDefault();
                        document.getElementById('filterInput').focus();
                    } else if (e.ctrlKey && e.key === 'ArrowUp') {
                        e.preventDefault();
                        this.editor.setValue(this.editor.getValue() + '\n--\n');
                    } else if (e.ctrlKey && e.key === 'ArrowDown') {
                        e.preventDefault();
                        this.editor.setValue(this.editor.getValue() + '\n/*\n');
                    }
                });
            },

            toggleExplorer(force) {
                const next = typeof force === 'boolean' ? force : !this.explorerVisible;
                this.explorerVisible = next;
                document.body.classList.toggle('explorer-collapsed', !next);
                const button = document.getElementById('toggleExplorerBtn');
                if (button) {
                    button.setAttribute('aria-expanded', String(next));
                }
                if (this.editor) {
                    requestAnimationFrame(() => this.editor.layout());
                }
            },

            handleCollapsedExplorerRailClick(event) {
                if (!document.body.classList.contains('explorer-collapsed')) return;
                if (event.target.closest('button, input, textarea, select, a, [role="button"]')) return;
                this.toggleExplorer(true);
            },

            toggleResultsPane(force) {
                const next = typeof force === 'boolean' ? force : !this.resultsVisible;
                this.resultsVisible = next;
                document.body.classList.toggle('results-collapsed', !next);
                if (this.editor) {
                    requestAnimationFrame(() => this.editor.layout());
                }
            },

            setupResizers() {
                const verticalResizer = document.getElementById('verticalResizer');
                const horizontalResizer = document.getElementById('horizontalResizer');
                const leftPane = document.querySelector('.left-pane');
                const rightPane = document.querySelector('.right-pane');
                const editorContainer = document.querySelector('.editor-container');
                const resultsContainer = document.querySelector('.results-container');
                const clearPointerStyles = () => {
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                };

                if (!verticalResizer || !horizontalResizer || !leftPane || !rightPane || !editorContainer || !resultsContainer) {
                    return;
                }

                const getMinHeight = (element, fallback) => {
                    const value = parseInt(window.getComputedStyle(element).minHeight, 10);
                    return Number.isNaN(value) ? fallback : value;
                };

                let verticalState = null;
                let horizontalState = null;

                const onVerticalPointerDown = (event) => {
                    event.preventDefault();
                    verticalResizer.setPointerCapture(event.pointerId);
                    verticalState = {
                        pointerId: event.pointerId,
                        startX: event.clientX,
                        startWidth: leftPane.offsetWidth,
                    };
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                };

                const onVerticalPointerMove = (event) => {
                    if (!verticalState || event.pointerId !== verticalState.pointerId) {
                        return;
                    }

                    const deltaX = event.clientX - verticalState.startX;
                    const newWidth = Math.min(
                        Math.max(verticalState.startWidth + deltaX, 200),
                        window.innerWidth - 400
                    );
                    leftPane.style.width = `${newWidth}px`;
                    rightPane.style.flex = `1 1 calc(100% - ${newWidth}px)`;
                };

                const onVerticalPointerUp = (event) => {
                    if (!verticalState || event.pointerId !== verticalState.pointerId) {
                        return;
                    }

                    verticalResizer.releasePointerCapture(verticalState.pointerId);
                    verticalState = null;
                    clearPointerStyles();
                };

                verticalResizer.addEventListener('pointerdown', onVerticalPointerDown);
                verticalResizer.addEventListener('pointermove', onVerticalPointerMove);
                verticalResizer.addEventListener('pointerup', onVerticalPointerUp);
                verticalResizer.addEventListener('pointercancel', onVerticalPointerUp);

                const applyHorizontalFlex = (editorHeight, resultsHeight) => {
                    if (!horizontalState) return;
                    const total = editorHeight + resultsHeight;
                    if (total <= 0) return;

                    const editorRatio = editorHeight / total;
                    const resultsRatio = resultsHeight / total;
                    const scale = 1000;
                    const editorGrow = Math.max(1, Math.round(editorRatio * scale));
                    const resultsGrow = Math.max(1, Math.round(resultsRatio * scale));

                    editorContainer.style.flex = `${editorGrow} 1 0%`;
                    resultsContainer.style.flex = `${resultsGrow} 1 0%`;

                    if (this.editor) {
                        this.editor.layout();
                    }

                    horizontalState.currentEditor = editorHeight;
                    horizontalState.currentResults = resultsHeight;
                };

                const onHorizontalPointerDown = (event) => {
                    event.preventDefault();
                    const totalHeight = editorContainer.offsetHeight + resultsContainer.offsetHeight;
                    horizontalState = {
                        pointerId: event.pointerId,
                        startY: event.clientY,
                        totalHeight,
                        editorInitial: editorContainer.offsetHeight,
                        editorMin: getMinHeight(editorContainer, 200),
                        resultsMin: getMinHeight(resultsContainer, 150),
                        currentEditor: null,
                        currentResults: null,
                    };
                    horizontalResizer.setPointerCapture(event.pointerId);
                    document.body.style.cursor = 'row-resize';
                    document.body.style.userSelect = 'none';
                };

                const onHorizontalPointerMove = (event) => {
                    if (!horizontalState || event.pointerId !== horizontalState.pointerId) {
                        return;
                    }

                    const deltaY = event.clientY - horizontalState.startY;
                    const availableHeight = horizontalState.totalHeight;
                    const editorMin = horizontalState.editorMin;
                    const resultsMin = horizontalState.resultsMin;

                    let editorHeight = horizontalState.editorInitial + deltaY;
                    editorHeight = Math.max(editorMin, Math.min(editorHeight, availableHeight - resultsMin));
                    const resultsHeight = availableHeight - editorHeight;

                    applyHorizontalFlex(editorHeight, resultsHeight);
                };

                const onHorizontalPointerUp = (event) => {
                    if (!horizontalState || event.pointerId !== horizontalState.pointerId) {
                        return;
                    }

                    horizontalResizer.releasePointerCapture(horizontalState.pointerId);
                    clearPointerStyles();

                    if (horizontalState.currentEditor != null && horizontalState.currentResults != null) {
                        applyHorizontalFlex(horizontalState.currentEditor, horizontalState.currentResults);
                    }

                    horizontalState = null;
                };

                horizontalResizer.addEventListener('pointerdown', onHorizontalPointerDown);
                horizontalResizer.addEventListener('pointermove', onHorizontalPointerMove);
                horizontalResizer.addEventListener('pointerup', onHorizontalPointerUp);
                horizontalResizer.addEventListener('pointercancel', onHorizontalPointerUp);
            }
    };

    window.app = app;

    document.addEventListener('DOMContentLoaded', () => app.init());
    </script>
</body>
</html>

