@page
@model SqlCmdr.Web.Pages.IndexModel
@{
    Layout = null;
    var title = $"SQL Commander: {Model.ServerName}/{Model.DatabaseName}";
}
<!DOCTYPE html>
<html id="appHtml" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=3" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/editor/editor.main.css">
    <link rel="stylesheet" href="~/css/sqlcmdr.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="main-content">
            <div class="left-pane" id="leftPane" onclick="app.handleCollapsedExplorerRailClick(event)">
                <div class="filter-box">
                    <button id="toggleExplorerBtn" class="icon-button" onclick="app.toggleExplorer()" title="Toggle Explorer (Ctrl+B)" aria-label="Toggle Explorer" data-i18n-title="toggleExplorerTitle" data-i18n-aria-label="toggleExplorer">☰</button>
                    <input type="text" id="filterInput" placeholder="Search..." aria-label="Search schema tree" data-i18n-placeholder="search" data-i18n-aria-label="searchSchemaTree" oninput="app.filterTree(this.value)">
                    <button id="clearFilterBtn" onclick="app.clearFilter()" title="Clear filter (Escape)" aria-label="Clear filter" data-i18n-title="clearFilterTitle" data-i18n-aria-label="clearFilter" style="display: none;">✕</button>
                </div>
                <div class="tree-container" id="treeContainer" role="tree" aria-label="Database schema tree" data-i18n-aria-label="databaseSchemaTree">
                    <div class="loading" data-i18n="loadingMetadata">Loading metadata...</div>
                </div>
                <label class="tree-options">
                    <input type="checkbox" id="showUserObjectsOnly" checked onchange="app.toggleUserObjectsOnly(this.checked)">
                    <span data-i18n="showUserObjectsOnly">Show user objects only</span>
                </label>
                <div class="schema-download">
                    <button id="settingsTreeBtn" class="schema-settings-button" type="button" title="Settings (Ctrl+,)" onclick="app.navigateTo('/app/settings/app')" data-i18n-title="settingsTitle"><span aria-hidden="true">⚙</span><span data-i18n="settings">Settings</span></button>
                    <button id="refreshMetadataBtn" type="button" data-i18n="refresh">Refresh</button>
                    <button id="viewSchemaBtn" type="button" title="Diagram (Ctrl+Shift+S)" data-i18n="viewSchema" data-i18n-title="diagramTitle">Diagram</button>
                </div>
                <button id="collapsedSettingsBtn" class="collapsed-settings-button" type="button" title="Settings (Ctrl+,)" aria-label="Settings" onclick="app.navigateTo('/app/settings/app')" data-i18n-title="settingsTitle" data-i18n-aria-label="settings">⚙</button>
            </div>

            <div class="vertical-resizer" id="verticalResizer"></div>

            <div class="right-pane">
                <div class="editor-container">
                    <div class="editor-toolbar">
                        <div class="toolbar-left">
                            <button id="executeBtn" class="execute" onclick="app.executeQuery()" title="Execute Query (Ctrl+E)" data-i18n-title="executeTitle">▶ <span data-i18n="execute">Execute</span></button>
                            <button id="cancelBtn" class="cancel" onclick="app.cancelQuery()" style="display: none;" data-i18n="cancel">Cancel</button>
                        </div>
                    </div>
                    <div class="editor">
                        <div id="sqlEditor"></div>
                    </div>
                </div>
                <div class="horizontal-resizer" id="horizontalResizer"></div>
                <div class="results-container" id="resultsContainer">
                    <div class="empty-state" data-i18n="noResults">No results to display.</div>
                </div>
            </div>
        </div>

        <div class="status-bar disconnected" id="statusBar">
            <div class="status-left">
                <span class="status-segment status-connection-segment" id="statusConnectionSegment" title="Connection status: Not Connected"><span class="status-value" id="statusConnection">Not Connected</span></span>
                <button type="button" class="status-segment status-data-api-segment" id="statusDataApiSegment" onclick="app.navigateTo('/app/data-api')" onkeydown="app.handleDataApiStatusKeyDown(event)" title="Data API status: Stopped&#10;Click to configure Data API."><span class="status-value" id="statusDataApi">Data API: Stopped</span></button>
            </div>
            <div class="status-right">
                <button type="button" class="status-segment status-server-segment" id="statusServerSegment" onclick="app.navigateTo('/app/settings/connection')" title="Server: N/A"><span class="status-value" id="statusServer">N/A</span></button>
                <button type="button" class="status-segment status-user-segment" id="statusUserSegment" onclick="app.navigateTo('/app/settings/connection')" title="User: N/A"><span class="status-value" id="statusUser">N/A</span></button>
                <button type="button" class="status-segment status-database-segment" id="statusDatabaseSegment" onclick="app.navigateTo('/app/settings/connection')" title="Database: N/A"><span class="status-value" id="statusDatabase">N/A</span></button>
                <span class="status-segment status-query-segment" id="statusQuerySegment" title="Query status: -"><span class="status-value" id="statusQuery">-</span></span>
                <span class="status-segment status-time-segment" id="statusTimeSegment" title="Query duration: -"><span class="status-value" id="statusTime">-</span></span>
                <span class="status-segment status-rows-segment" id="statusRowsSegment" title="Rows returned: -"><span class="status-value" id="statusRows">-</span></span>
            </div>
        </div>
    </div>

    <div class="status-popover" id="dataApiStatusMenu" hidden>
        <button type="button" id="dataApiMenuStop" onclick="app.stopDataApi()" data-i18n="stop">Stop Data API server</button>
        <button type="button" id="dataApiMenuHealth" onclick="app.openDataApiUrl('health')" data-i18n="viewHealth">View Health</button>
        <button type="button" id="dataApiMenuSwagger" onclick="app.openDataApiUrl('swagger')" data-i18n="openSwagger">Open Swagger</button>
        <button type="button" id="dataApiMenuGraphQL" onclick="app.openDataApiUrl('graphql')" data-i18n="openGraphQL">Open GraphQL</button>
    </div>

    <!-- Settings Modal -->
    <div class="modal" id="settingsModal" onclick="app.handleModalClick(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header" data-i18n="settings">Settings</div>
            <div class="settings-tabs" role="tablist">
                <button type="button" class="active" data-settings-tab="app" onclick="app.navigateTo('/app/settings/app')" data-i18n="appSettings">App Settings</button>
                <button type="button" data-settings-tab="properties" onclick="app.navigateTo('/app/settings/connection')" data-i18n="connectionProperties">Connection Properties</button>
                <button type="button" data-settings-tab="connectionString" onclick="app.navigateTo('/app/settings/connection-string')" data-i18n="connectionString">Connection String</button>
                <button type="button" data-settings-tab="dataApi" onclick="app.navigateTo('/app/settings/data-api')" data-i18n="dataApi">Data API</button>
                <button type="button" data-settings-tab="navigation" onclick="app.navigateTo('/app/settings/navigation')" data-i18n="navigation">Navigation</button>
            </div>
            <div class="settings-panel active" id="settingsAppPanel">
                <div class="form-grid">
                    <div class="form-group">
                        <label data-i18n="theme">Theme</label>
                        <select id="settingTheme">
                            <option value="dark">Dark</option>
                            <option value="light">Light</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label data-i18n="language">Language</label>
                        <select id="settingLanguage" onchange="app.previewLanguage(this.value)">
                            <option value="en">English</option>
                            <option value="es">Español</option>
                        </select>
                    </div>
                    <div class="form-group span-2">
                        <label data-i18n="defaultResultLimit">Default Result Limit</label>
                        <input type="number" id="settingResultLimit" value="100" min="1">
                    </div>
                    <label class="checkbox-row span-2"><input type="checkbox" id="settingConfirmActions"> <span data-i18n="confirmActions">Show confirmation dialogs before actions</span></label>
                    <label class="checkbox-row span-2"><input type="checkbox" id="settingPromptWhenOverwritingEditorContent"> <span data-i18n="promptWhenOverwritingEditorContent">Prompt when overwriting editor content</span></label>
                </div>
            </div>
            <div class="settings-panel" id="settingsPropertiesPanel">
                <div class="form-grid">
                    <div class="form-group">
                        <label data-i18n="serverName">Server Name</label>
                        <input type="text" id="settingServer">
                    </div>
                    <div class="form-group">
                        <label data-i18n="databaseName">Database Name</label>
                        <input type="text" id="settingDatabase">
                    </div>
                    <div class="form-group span-2">
                        <label data-i18n="authentication">Authentication</label>
                        <select id="settingAuthType" onchange="app.onAuthTypeChange()">
                            <option value="0">SQL Server Authentication</option>
                            <option value="1">Azure Default Credential</option>
                            <option value="2">Azure Managed Identity</option>
                        </select>
                    </div>
                    <div class="auth-guidance span-2" id="authTypeHelp" role="note"></div>
                    <div class="form-group" id="sqlAuthFields">
                        <label data-i18n="userName">User Name</label>
                        <input type="text" id="settingUserId" autocomplete="username">
                    </div>
                    <div class="form-group" id="sqlPasswordField">
                        <label data-i18n="password">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="settingPassword" autocomplete="current-password">
                            <button type="button" class="password-toggle" onclick="app.togglePasswordVisibility()" aria-label="Show password">👀</button>
                        </div>
                    </div>
                    <div class="span-2 advanced-toggle-row">
                        <button type="button" class="secondary inline-toggle" id="advancedConnectionToggle" onclick="app.toggleAdvancedConnectionSettings()" data-i18n="showAdvanced">Show advanced</button>
                    </div>
                    <div class="advanced-settings span-2" id="advancedConnectionSettings" hidden>
                        <div class="advanced-connection-grid">
                            <div class="form-group">
                                <label data-i18n="connectionTimeout">Connection Timeout</label>
                                <input type="number" id="settingConnectionTimeout" value="30" min="0">
                            </div>
                            <div class="form-group">
                                <label data-i18n="commandTimeout">Command Timeout</label>
                                <input type="number" id="settingCommandTimeout" value="300" min="0">
                            </div>
                            <div class="form-group">
                                <label data-i18n="applicationName">Application Name</label>
                                <input type="text" id="settingApplicationName">
                            </div>
                            <div class="form-group">
                                <label data-i18n="encrypt">Encrypt</label>
                                <select id="settingEncrypt">
                                    <option value="Mandatory">Mandatory</option>
                                    <option value="Optional">Optional</option>
                                    <option value="Strict">Strict</option>
                                </select>
                            </div>
                            <div class="advanced-checkbox-grid">
                                <label class="checkbox-row"><input type="checkbox" id="settingPooling"> <span data-i18n="pooling">Pooling</span></label>
                                <label class="checkbox-row"><input type="checkbox" id="settingMars"> <span data-i18n="mars">Multiple Active Result Sets</span></label>
                                <label class="checkbox-row"><input type="checkbox" id="settingTrustServerCert"> <span data-i18n="trustServerCertificate">Trust Server Certificate</span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="settings-panel" id="settingsConnectionStringPanel">
                <div class="form-group">
                    <label data-i18n="generatedConnectionString">Generated Connection String</label>
                    <textarea id="settingConnectionString" readonly rows="5"></textarea>
                </div>
                <div class="inline-actions">
                    <button type="button" onclick="app.copyConnectionString()" data-i18n="copy">Copy</button>
                </div>
                <div class="form-group">
                    <label data-i18n="pasteConnectionString">Paste Connection String</label>
                    <textarea id="settingConnectionStringInput" rows="5"></textarea>
                </div>
                <div class="inline-actions">
                    <button type="button" onclick="app.parseConnectionStringIntoSettings()" data-i18n="parseIntoSettings">Parse into Settings</button>
                </div>
            </div>
            <div class="settings-panel" id="settingsDataApiPanel">
                <div class="form-grid">
                    <div class="data-api-option-row span-2">
                        <label class="checkbox-row"><input type="checkbox" id="settingDataApiRestEnabled"> <span data-i18n="restHelp">REST</span></label>
                        <label class="checkbox-row"><input type="checkbox" id="settingDataApiGraphQLEnabled"> <span data-i18n="graphqlHelp">GraphQL</span></label>
                        <label class="checkbox-row"><input type="checkbox" id="settingDataApiMcpEnabled"> <span data-i18n="mcpHelp">MCP</span></label>
                    </div>
                    <div class="data-api-runtime-card span-2">
                        <div>
                            <div class="runtime-title" data-i18n="runtimeStatus">Runtime Status</div>
                            <div class="runtime-subtitle" id="settingsDataApiStatus">Stopped</div>
                        </div>
                        <button type="button" class="danger" id="settingsDataApiStopBtn" onclick="app.stopDataApi()" hidden data-i18n="stop">Stop Data API server</button>
                    </div>
                </div>
            </div>
            <div class="settings-panel" id="settingsNavigationPanel">
                <div class="navigation-panel-copy" data-i18n="navigationIntro">SQL Commander supports deep links for common UI views. Use these links to navigate directly or copy/share the URL.</div>
                <div class="navigation-route-list" id="navigationRouteList"></div>
            </div>
            <div class="modal-actions">
                <button id="testConnectionBtn" onclick="app.testConnection()" data-i18n="testConnection">Test Connection</button>
                <div class="modal-actions-right">
                    <button class="primary" onclick="app.applySettings()" data-i18n="apply">Save</button>
                    <button class="secondary" onclick="app.hideSettings()" data-i18n="close">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data API Modal -->
    <div class="modal" id="dabModal" onclick="app.handleModalClick(event)">
        <div class="modal-content dab-modal" onclick="event.stopPropagation()">
            <div class="modal-header modal-header-row">
                <span>Data API</span>
                <button type="button" class="secondary" onclick="app.hideDabDialog()" aria-label="Close" data-i18n-aria-label="close">×</button>
            </div>
            <div id="dabSelectPanel" class="dab-select-panel">
                <div class="dab-command-bar">
                    <div class="dab-primary-actions">
                        <button type="button" class="secondary" onclick="app.generateDabConfig()" data-i18n="viewConfig">Preview Config File</button>
                        <button type="button" class="primary" id="dabStartButton" onclick="app.startDataApi()" data-i18n="start">▶ Start</button>
                    </div>
                </div>
                <div class="dab-inline-options" aria-label="Data API features">
                    <label class="dab-feature-card"><input type="checkbox" id="dabRestEnabled"><span data-i18n="restHelp">REST</span></label>
                    <label class="dab-feature-card"><input type="checkbox" id="dabGraphQLEnabled"><span data-i18n="graphqlHelp">GraphQL</span></label>
                    <label class="dab-feature-card"><input type="checkbox" id="dabMcpEnabled"><span data-i18n="mcpHelp">MCP</span></label>
                </div>
                <div class="dab-dialog-body">
                    <section class="dab-tab-panel active" id="dabObjectsPanel" aria-label="Database objects" data-i18n-aria-label="databaseObjects">
                        <div class="dab-filters">
                            <input type="text" id="dabObjectFilter" placeholder="Filter objects..." data-i18n-placeholder="filterObjects" oninput="app.filterDabObjects()">
                            <select id="dabSelectionFilter" onchange="app.filterDabObjects()" aria-label="Filter by selected state" data-i18n-aria-label="filterBySelectedState">
                                <option value="all" data-i18n="allObjects">All</option>
                                <option value="selected" data-i18n="selectedObjects">Selected</option>
                                <option value="unselected" data-i18n="unselectedObjects">Unselected</option>
                            </select>
                        </div>
                        <div class="dab-object-list" id="dabObjectList"></div>
                    </section>
                </div>
            </div>
            <div id="dabRuntimePanel" class="dab-runtime-panel" hidden>
                <div class="dab-runtime-card">
                    <div class="dab-runtime-state" id="dabRuntimeState" data-i18n="dataApiIsRunning">Data API is running</div>
                    <div class="dab-runtime-endpoints" id="dabRuntimeEndpoints" aria-label="Data API endpoints" data-i18n-aria-label="dataApiEndpoints"></div>
                    <div class="dab-runtime-actions">
                        <button type="button" class="primary" id="dabRuntimeConfigureBtn" onclick="app.backToDabSelection()" data-i18n="configureStart">Configure / Start</button>
                        <button type="button" class="danger" id="dabRuntimeStopBtn" onclick="app.stopDataApi()" data-i18n="stop">Stop Data API server</button>
                    </div>
                </div>
            </div>
            <div id="dabWorkingPanel" class="dab-working" hidden>
                <div class="spinner"></div>
                <div id="dabWorkingText" data-i18n="dabWorking">Preparing Data API with the Data API CLI...</div>
            </div>
            <div id="dabOutputPanel" class="dab-output-panel" hidden>
                <div class="dab-output-header">
                    <button type="button" class="secondary dab-back-button" onclick="app.backToDabSelection()" data-i18n="backToObjects">← Back to Objects</button>
                    <div class="modal-description" id="dabOutputSummary" aria-live="polite"></div>
                    <div class="dab-primary-actions dab-output-actions">
                        <button type="button" class="secondary" data-dab-config-action data-dab-copy-button onclick="app.copyDabConfig(this)" data-i18n="copy">Copy</button>
                        <button type="button" class="primary" data-dab-config-action onclick="app.downloadDabConfig()" data-i18n="download">Download</button>
                    </div>
                </div>
                <pre id="dabConfigOutput" class="json-output"></pre>
                <details id="dabDiagnosticsDetails" class="diagnostics-details" hidden>
                    <summary>Diagnostics</summary>
                    <pre id="dabDiagnosticsOutput"></pre>
                </details>
            </div>
        </div>
    </div>

    <!-- Schema Modal -->
    <div class="modal" id="schemaModal" onclick="app.handleModalClick(event)">
        <div class="modal-content schema-modal" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span data-i18n="databaseSchema">Database Schema</span>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <span style="font-size: 12px; color: var(--text-secondary);" data-i18n="zoom">Zoom:</span>
                        <button onclick="app.zoomSchema(0.75)" style="padding: 4px 12px; font-size: 14px;" title="Zoom Out (Ctrl + Mouse Wheel Down)" data-i18n-title="zoomOutTitle">−</button>
                        <button onclick="app.zoomSchema(1.5)" style="padding: 4px 12px; font-size: 14px;" title="Zoom In (Ctrl + Mouse Wheel Up)" data-i18n-title="zoomInTitle">+</button>
                        <button onclick="app.zoomSchema('reset')" style="padding: 4px 12px; font-size: 12px;" title="Reset Zoom" data-i18n="reset" data-i18n-title="resetZoomTitle">Reset</button>
                        <button onclick="app.zoomSchema('fit')" style="padding: 4px 12px; font-size: 12px;" title="Fit to Window" data-i18n="fit" data-i18n-title="fitToWindowTitle">Fit</button>
                        <span id="zoomLevel" style="font-size: 12px; color: var(--text-secondary); min-width: 50px; text-align: right;"></span>
                    </div>
                </div>
            </div>
            <div id="schemaContainer">
                <div id="schemaHint" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); 
                     background: rgba(0,0,0,0.8); color: white; padding: 16px 24px; border-radius: 8px; 
                     font-size: 14px; text-align: center; pointer-events: none; opacity: 0; transition: opacity 0.3s;">
                    <div style="font-weight: 500; margin-bottom: 8px;" data-i18n="navigationTips">💡 Navigation Tips</div>
                    <div style="font-size: 12px; line-height: 1.6;">
                        <span data-i18n="schemaNavigationPanZoom">Drag to pan • Ctrl + Scroll to zoom</span><br>
                        <span data-i18n="schemaNavigationKeyboard">+/− keys to zoom • F to fit • 0 to reset</span>
                    </div>
                </div>
            </div>
            <div class="modal-actions" style="justify-content: flex-end;">
                <button class="secondary" onclick="app.hideSchema()" data-i18n="close">Close</button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
    <script>
        const app = {
            metadata: null,
            queryRunning: false,
            queryCancelled: false,
            startTime: null,
            timerInterval: null,
            settings: null,
            editor: null,
            mermaidPromise: null,
            currentSchemaScale: 2.5,
            baseSchemaWidth: 800,
            baseSchemaHeight: 600,
            isPanning: false,
            panStart: { x: 0, y: 0 },
            scrollStart: { x: 0, y: 0 },
            maxMetadataAttempts: 3,
            metadataAttemptDelay: 1500,
            metadataLoading: false,
            lastMetadataError: null,
            language: 'en',
            resultsVisible: true,
            explorerVisible: true,
            generatedDabConfig: '',
            generatedDabFileName: 'dab-config.json',
            dataApiStatus: { state: 'stopped', running: false },
            dataApiStatusInterval: null,
            testConnectionFeedbackTimer: null,
            dataApiStarting: false,
            dabCopyFeedbackTimer: null,
            showUserObjectsOnly: true,
            showDabUserObjectsOnly: true,
            dabUnsupportedSqlTypes: new Set(['geography', 'geometry', 'hierarchyid', 'json', 'rowversion', 'timestamp', 'sql_variant', 'vector', 'xml']),
            currentAppRoute: '/',
            applyingRoute: false,
            lastRouteConnectionString: '',
            appRoutes: [
                { path: '/app/query', labelKey: 'routeQuery', descriptionKey: 'routeQueryDescription' },
                { path: '/app/diagram', labelKey: 'routeDiagram', descriptionKey: 'routeDiagramDescription' },
                { path: '/app/settings/app', labelKey: 'routeSettingsApp', descriptionKey: 'routeSettingsAppDescription' },
                { path: '/app/settings/connection', labelKey: 'routeSettingsConnection', descriptionKey: 'routeSettingsConnectionDescription' },
                { path: '/app/settings/connection-string', labelKey: 'routeSettingsConnectionString', descriptionKey: 'routeSettingsConnectionStringDescription' },
                { path: '/app/settings/data-api', labelKey: 'routeSettingsDataApi', descriptionKey: 'routeSettingsDataApiDescription' },
                { path: '/app/settings/navigation', labelKey: 'routeSettingsNavigation', descriptionKey: 'routeSettingsNavigationDescription' },
                { path: '/app/data-api', labelKey: 'routeDataApi', descriptionKey: 'routeDataApiDescription' },
                { path: '/app/data-api/objects', labelKey: 'routeDataApiObjects', descriptionKey: 'routeDataApiObjectsDescription' },
                { path: '/app/data-api/running', labelKey: 'routeDataApiRunning', descriptionKey: 'routeDataApiRunningDescription' }
            ],
            translations: {
                en: {
                    search: 'Search...', loadingMetadata: 'Loading metadata...', refresh: 'Refresh', viewSchema: 'Diagram',
                    execute: 'Execute', cancel: 'Cancel', settings: 'Settings', appSettings: 'App Settings', dataApi: 'Data API', navigation: 'Navigation', noResults: 'No results to display.', connectionProperties: 'Connection Properties',
                    connectionString: 'Connection String', serverName: 'Server Name', authentication: 'Authentication', userName: 'User Name', password: 'Password',
                    rememberPassword: 'Remember Password', databaseName: 'Database Name', encrypt: 'Encrypt', trustServerCertificate: 'Trust Server Certificate',
                    connectionTimeout: 'Connection Timeout', commandTimeout: 'Command Timeout', applicationName: 'Application Name', pooling: 'Pooling', mars: 'Multiple Active Result Sets',
                    confirmActions: 'Show confirmation dialogs before actions', promptWhenOverwritingEditorContent: 'Prompt when overwriting editor content', connectionName: 'Name', theme: 'Theme',
                    language: 'Language', defaultResultLimit: 'Default Result Limit', generatedConnectionString: 'Generated Connection String', copy: 'Copy',
                    pasteConnectionString: 'Paste Connection String', parseConnectionStringHelp: '',
                    parseIntoSettings: 'Parse into Settings', testConnection: 'Test Connection', apply: 'Save', close: 'Close', selectAll: 'Select All', selectNone: 'Select None',
                    generate: 'Generate', viewConfig: 'Preview Config File', start: '▶ Start', stop: 'Stop Data API server', download: 'Download', backToObjects: '← Back to Objects', databaseObjects: 'Database Objects', dataApiSettings: 'Data API Settings', dabIntro: '',
                    dabWorking: 'Preparing Data API with the Data API CLI...', connected: 'Connected', connecting: 'Connecting...', notConnected: 'Not Connected',
                    failed: 'Connection Failed', idle: '-', running: 'Running...', completed: 'Completed', cancelled: 'Cancelled', tables: 'Tables', views: 'Views', storedProcedures: 'Stored Procedures', showUserObjectsOnly: 'Show user objects only',
